//@version=6
indicator("AuctionAI v2.2 - Candidate Engine + Adaptive Research", overlay=true, max_bars_back=5000)

// v2.2 = v2.1 Candidate Engine + Research Layer.
// Research may recommend Candidates, but NEVER changes parameters automatically.
// Baseline is the permanent control. Exactly ONE challenger Candidate may be in
// SHADOW at a time. Human approval is explicitly tied to a Candidate ID.

validationHorizon = input.int(5, "Validation Horizon", minval=1)
favorableAtr = input.float(0.50, "Favorable Outcome ATR", minval=0, step=0.05)
minPattern = input.int(20, "Minimum Pattern Sample", minval=20)
recentN = input.int(20, "Recent Pattern Samples", minval=5)
minCompetition = input.int(10, "Minimum Competition Samples", minval=5)
minHoldout = input.int(10, "Minimum Holdout Samples", minval=5)
archiveLimit = input.int(500, "Research Memory", minval=100)
maxCandidates = input.int(20, "Candidate Registry", minval=4)
approvedCandidateId = input.int(0, "HUMAN APPROVAL — Candidate ID", minval=0)
activeShadowCandidateId = input.int(0, "ACTIVE SHADOW Candidate ID", minval=0)

atr = ta.atr(14)
volMean = ta.sma(volume, 20)
body = math.abs(close - open)
rng = high - low
barDir = close > open ? 1 : close < open ? -1 : 0
breakout = close > ta.highest(high, 20)[1] or close < ta.lowest(low, 20)[1]
strongBody = atr > 0 and body / atr >= 0.8
delta = volume * barDir
cvd = ta.cum(delta)
deltaImpulse = math.abs(delta) > volMean
cvdImpulse = math.abs(cvd - cvd[1]) > ta.sma(math.abs(cvd - cvd[1]), 20)
effort = volMean > 0 ? volume / volMean : 0
absorption = rng > 0 and body / rng < 0.35 and volume > volMean * 1.25
evidenceMask = (breakout ? 1 : 0) + (strongBody ? 2 : 0) + (deltaImpulse ? 4 : 0) + (cvdImpulse ? 8 : 0) + (effort > 1.2 ? 16 : 0) + (absorption ? 32 : 0)
evidenceScore = (breakout ? 2 : 0) + (strongBody ? 1 : 0) + (barDir != 0 ? 1 : 0) + (deltaImpulse ? 2 : 0) + (cvdImpulse ? 2 : 0) + (effort > 1.2 ? 1 : 0) + (absorption ? -3 : 0)

ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
context = math.abs(ema20 - ema50) > atr * 0.35 ? 1 : 0
direction = barDir
lastBreakout = ta.valuewhen(breakout, close, 0)
retestDistance = not na(lastBreakout) ? math.abs(close - lastBreakout) / math.max(atr, syminfo.mintick) : na
retest = not na(retestDistance) ? retestDistance <= 0.35 ? 1 : retestDistance <= 0.8 ? 2 : 0 : 0
session = hour(time, "UTC") < 8 ? 0 : hour(time, "UTC") < 13 ? 1 : hour(time, "UTC") < 18 ? 2 : 3

// ---------------- CANDIDATE REGISTRY ----------------------------------------
var ids = array.new_int()
var names = array.new_string()
var thresholds = array.new_int()
var trainS = array.new_int()
var trainW = array.new_int()
var holdS = array.new_int()
var holdW = array.new_int()
var approved = array.new_bool()
var active = array.new_bool()
var rolled = array.new_bool()
var scores = array.new_float()

if barstate.isfirst
    array.push(ids, 1)
    array.push(names, "BASELINE")
    array.push(thresholds, 5)
    array.push(trainS, 0)
    array.push(trainW, 0)
    array.push(holdS, 0)
    array.push(holdW, 0)
    array.push(approved, true)
    array.push(active, true)
    array.push(rolled, false)
    array.push(scores, 0.0)

// ---------------- CAUSAL QUEUE ----------------------------------------------
var qBar = array.new_int()
var qPrice = array.new_float()
var qAtr = array.new_float()
var qDir = array.new_int()
var qCtx = array.new_int()
var qRetest = array.new_int()
var qSession = array.new_int()
var qEvidence = array.new_int()
var qCid = array.new_int()
var qHold = array.new_bool()

// Baseline is the permanent control. Only the selected Challenger can shadow.
shadowIdx = array.indexof(ids, activeShadowCandidateId)
shadowExists = activeShadowCandidateId > 1 and shadowIdx >= 0 and array.get(active, shadowIdx) and array.get(approved, shadowIdx) and not array.get(rolled, shadowIdx)

baselineSignal = barstate.isconfirmed and direction != 0 and evidenceScore >= array.get(thresholds, 0)
shadowSignal = barstate.isconfirmed and shadowExists and direction != 0 and evidenceScore >= array.get(thresholds, shadowIdx)

if baselineSignal and array.size(qBar) < 500
    array.push(qBar, bar_index)
    array.push(qPrice, close)
    array.push(qAtr, math.max(atr, syminfo.mintick))
    array.push(qDir, direction)
    array.push(qCtx, context)
    array.push(qRetest, retest)
    array.push(qSession, session)
    array.push(qEvidence, evidenceMask)
    array.push(qCid, 1)
    array.push(qHold, bar_index % 5 == 0)

if shadowSignal and array.size(qBar) < 500
    array.push(qBar, bar_index)
    array.push(qPrice, close)
    array.push(qAtr, math.max(atr, syminfo.mintick))
    array.push(qDir, direction)
    array.push(qCtx, context)
    array.push(qRetest, retest)
    array.push(qSession, session)
    array.push(qEvidence, evidenceMask)
    array.push(qCid, activeShadowCandidateId)
    array.push(qHold, bar_index % 5 == 0)

// ---------------- RESEARCH MEMORY -------------------------------------------
var mCtx = array.new_int()
var mDir = array.new_int()
var mRet = array.new_int()
var mSession = array.new_int()
var mEvidence = array.new_int()
var mOut = array.new_int()
var mCid = array.new_int()
var mBar = array.new_int()
var mHold = array.new_bool()

memPush(c, d, r, s, e, o, cid, b, h) =>
    array.push(mCtx, c)
    array.push(mDir, d)
    array.push(mRet, r)
    array.push(mSession, s)
    array.push(mEvidence, e)
    array.push(mOut, o)
    array.push(mCid, cid)
    array.push(mBar, b)
    array.push(mHold, h)
    if array.size(mCtx) > archiveLimit
        array.shift(mCtx)
        array.shift(mDir)
        array.shift(mRet)
        array.shift(mSession)
        array.shift(mEvidence)
        array.shift(mOut)
        array.shift(mCid)
        array.shift(mBar)
        array.shift(mHold)

if array.size(qBar) > 0
    for i = array.size(qBar) - 1 to 0
        if bar_index - array.get(qBar, i) >= validationHorizon
            entry = array.get(qPrice, i)
            decisionAtr = array.get(qAtr, i)
            d = array.get(qDir, i)
            move = (close - entry) / decisionAtr
            outcome = d > 0 ? (move >= favorableAtr ? 1 : -1) : (move <= -favorableAtr ? 1 : -1)
            cid = array.get(qCid, i)
            isHoldout = array.get(qHold, i)
            memPush(array.get(qCtx, i), d, array.get(qRetest, i), array.get(qSession, i), array.get(qEvidence, i), outcome, cid, array.get(qBar, i), isHoldout)
            ci = array.indexof(ids, cid)
            if ci >= 0
                if isHoldout
                    array.set(holdS, ci, array.get(holdS, ci) + 1)
                    array.set(holdW, ci, array.get(holdW, ci) + (outcome == 1 ? 1 : 0))
                else
                    array.set(trainS, ci, array.get(trainS, ci) + 1)
                    array.set(trainW, ci, array.get(trainW, ci) + (outcome == 1 ? 1 : 0))
            array.remove(qBar, i)
            array.remove(qPrice, i)
            array.remove(qAtr, i)
            array.remove(qDir, i)
            array.remove(qCtx, i)
            array.remove(qRetest, i)
            array.remove(qSession, i)
            array.remove(qEvidence, i)
            array.remove(qCid, i)
            array.remove(qHold, i)

// ---------------- RESEARCH MINING -------------------------------------------
patternKey(c, d, r) => c * 100 + (d + 1) * 10 + r
currentPatternKey = patternKey(context, direction, retest)

patternStats(k, recentOnly) =>
    s = 0
    w = 0
    if array.size(mCtx) > 0
        for i = 0 to array.size(mCtx) - 1
            age = bar_index - array.get(mBar, i)
            matches = patternKey(array.get(mCtx, i), array.get(mDir, i), array.get(mRet, i)) == k
            recentOk = not recentOnly or age <= recentN * validationHorizon
            if matches and recentOk
                s += 1
                w += array.get(mOut, i) == 1 ? 1 : 0
    [s, w, s > 0 ? w / s : na]

[sAll, wAll, rateAll] = patternStats(currentPatternKey, false)
[sRecent, wRecent, rateRecent] = patternStats(currentPatternKey, true)
histS = math.max(sAll - sRecent, 0)
histW = math.max(wAll - wRecent, 0)
histRate = histS > 0 ? histW / histS : na
patternDrift = sRecent >= minHoldout and histS >= minPattern and rateRecent < histRate - 0.15

priorS = 0
priorW = 0
if array.size(mCtx) > 0
    for i = 0 to array.size(mCtx) - 1
        age = bar_index - array.get(mBar, i)
        if patternKey(array.get(mCtx, i), array.get(mDir, i), array.get(mRet, i)) == currentPatternKey and age > recentN * validationHorizon and age <= recentN * validationHorizon * 2
            priorS += 1
            priorW += array.get(mOut, i) == 1 ? 1 : 0
priorRate = priorS > 0 ? priorW / priorS : na
patternRecovery = sRecent >= minHoldout and priorS >= minHoldout and rateRecent > priorRate + 0.10

// All 15 Evidence pair interactions are mined generically.
var pairKeys = array.new_int()
var pairS = array.new_int()
var pairW = array.new_int()
if barstate.isfirst
    for a = 0 to 4
        for b = a + 1 to 5
            pk = (1 << a) + (1 << b)
            array.push(pairKeys, pk)
            array.push(pairS, 0)
            array.push(pairW, 0)

if array.size(mEvidence) > 0
    for j = 0 to array.size(pairKeys) - 1
        sm = 0
        ww = 0
        pk = array.get(pairKeys, j)
        for i = 0 to array.size(mEvidence) - 1
            if (array.get(mEvidence, i) & pk) == pk
                sm += 1
                ww += array.get(mOut, i) == 1 ? 1 : 0
        array.set(pairS, j, sm)
        array.set(pairW, j, ww)

bestPair = 0
bestPairRate = na
bestPairS = 0
for j = 0 to array.size(pairKeys) - 1
    ps = array.get(pairS, j)
    if ps >= minPattern
        pr = array.get(pairW, j) / ps
        if na(bestPairRate) or pr > bestPairRate
            bestPairRate := pr
            bestPairS := ps
            bestPair := array.get(pairKeys, j)

// ---------------- RESEARCH -> CANDIDATE -------------------------------------
// A Research Recommendation may create a PENDING Candidate with fixed
// parameters. It does not activate it. Approval is per Candidate ID.
var lastRecommendationKey = na
researchRecommendation = bestPairS >= minPattern and (na(rateAll) or bestPairRate > rateAll + 0.05)
if researchRecommendation and (na(lastRecommendationKey) or lastRecommendationKey != currentPatternKey) and array.size(ids) < maxCandidates
    newId = array.size(ids) + 1
    suggestedThreshold = bestPairRate >= 0.70 ? 7 : 6
    array.push(ids, newId)
    array.push(names, "RESEARCH_P" + str.tostring(newId))
    array.push(thresholds, suggestedThreshold)
    array.push(trainS, 0)
    array.push(trainW, 0)
    array.push(holdS, 0)
    array.push(holdW, 0)
    array.push(approved, false)
    array.push(active, true)
    array.push(rolled, false)
    array.push(scores, na)
    lastRecommendationKey := currentPatternKey

// Explicit per-Candidate human approval. There is no global approval switch.
if array.size(ids) > 1
    for i = 1 to array.size(ids) - 1
        array.set(approved, i, array.get(ids, i) == approvedCandidateId)

// ---------------- COMPETITION ------------------------------------------------
// Fixed composite score: Training + OOS Lift + Stability + Quality + Confidence
// - Regression penalty. OOS is always measured against the permanent baseline.
baseTrain = array.get(trainS, 0) > 0 ? array.get(trainW, 0) / array.get(trainS, 0) : na
baseOos = array.get(holdS, 0) >= minHoldout ? array.get(holdW, 0) / array.get(holdS, 0) : na

champ = -1
bestScore = -1e9
if array.size(ids) > 1
    for i = 1 to array.size(ids) - 1
        ts = array.get(trainS, i)
        tw = array.get(trainW, i)
        hs = array.get(holdS, i)
        hw = array.get(holdW, i)
        trainRate = ts > 0 ? tw / ts : na
        oosRate = hs >= minHoldout ? hw / hs : na
        oosLift = not na(oosRate) and not na(baseOos) ? oosRate - baseOos : 0.0
        stability = not na(trainRate) and not na(oosRate) ? 1.0 - math.min(math.abs(trainRate - oosRate), 1.0) : 0.0
        quality = ts >= minCompetition ? math.min(ts / minCompetition, 2.0) / 2.0 : 0.0
        confidence = ts + hs >= 40 ? 1.0 : ts + hs >= 20 ? 0.7 : 0.4
        regression = not na(baseOos) and not na(oosRate) and oosRate < baseOos - 0.10 ? 1.0 : 0.0
        score = not na(trainRate) ? trainRate * 0.20 + oosLift * 0.40 + stability * 0.15 + quality * 0.10 + confidence * 0.10 - regression * 0.15 : -1e9
        array.set(scores, i, score)
        if score > bestScore
            bestScore := score
            champ := i

champName = champ >= 0 ? array.get(names, champ) : "NONE"

// Monitoring / rollback is a warning state. It does not select a replacement.
activeIdx = array.indexof(ids, activeShadowCandidateId)
activeOos = activeIdx > 0 and array.get(holdS, activeIdx) >= minHoldout ? array.get(holdW, activeIdx) / array.get(holdS, activeIdx) : na
rollbackWarning = activeIdx > 0 and not na(baseOos) and not na(activeOos) and activeOos < baseOos - 0.10
if rollbackWarning
    array.set(rolled, activeIdx, true)

researchConfidence = sAll < minPattern ? "LOW" : histS < minPattern or sRecent < minHoldout ? "MEDIUM" : "HIGH"
lifecycle = patternDrift ? "DRIFT" : patternRecovery ? "RECOVERY" : sAll >= minPattern ? "RELIABLE" : "EMERGING"
recommendationText = patternDrift ? "REVIEW DRIFT" : patternRecovery ? "CONTINUE OBSERVATION" : researchRecommendation ? "CREATE CANDIDATE FROM RESEARCH" : "COLLECT MORE DATA"

// ---------------- PANEL -----------------------------------------------------
var table t = table.new(position.top_right, 2, 18, border_width=1)
if barstate.islast
    activeName = activeIdx > 0 ? array.get(names, activeIdx) : "NONE"
    table.cell(t, 0, 0, "AuctionAI v2.2")
    table.cell(t, 1, 0, "v2.1 + Research")
    table.cell(t, 0, 1, "Active Shadow")
    table.cell(t, 1, 1, activeName)
    table.cell(t, 0, 2, "Research Champion")
    table.cell(t, 1, 2, champName)
    table.cell(t, 0, 3, "Approved ID")
    table.cell(t, 1, 3, str.tostring(approvedCandidateId))
    table.cell(t, 0, 4, "Baseline OOS")
    table.cell(t, 1, 4, not na(baseOos) ? str.tostring(baseOos * 100, "#.0") + "%" : "WAIT")
    table.cell(t, 0, 5, "Candidate OOS")
    table.cell(t, 1, 5, not na(activeOos) ? str.tostring(activeOos * 100, "#.0") + "%" : "WAIT")
    table.cell(t, 0, 6, "Candidate OOS Lift")
    table.cell(t, 1, 6, not na(activeOos) and not na(baseOos) ? str.tostring((activeOos - baseOos) * 100, "#.0") + "%" : "WAIT")
    table.cell(t, 0, 7, "Pattern Samples")
    table.cell(t, 1, 7, str.tostring(sAll))
    table.cell(t, 0, 8, "Historical / Recent")
    table.cell(t, 1, 8, not na(histRate) ? str.tostring(histRate * 100, "#.0") + "% / " + str.tostring(rateRecent * 100, "#.0") + "%" : "BUILDING")
    table.cell(t, 0, 9, "Lifecycle")
    table.cell(t, 1, 9, lifecycle)
    table.cell(t, 0, 10, "Research Confidence")
    table.cell(t, 1, 10, researchConfidence)
    table.cell(t, 0, 11, "Best Interaction")
    table.cell(t, 1, 11, bestPairS >= minPattern ? str.tostring(bestPair) + " @ " + str.tostring(bestPairRate * 100, "#.0") + "%" : "INSUFFICIENT")
    table.cell(t, 0, 12, "Recommendation")
    table.cell(t, 1, 12, recommendationText)
    table.cell(t, 0, 13, "Rollback Monitor")
    table.cell(t, 1, 13, rollbackWarning ? "WARNING" : "STABLE")
    table.cell(t, 0, 14, "Pending Queue")
    table.cell(t, 1, 14, str.tostring(array.size(qBar)))
    table.cell(t, 0, 15, "Registry")
    table.cell(t, 1, 15, str.tostring(array.size(ids)))
    table.cell(t, 0, 16, "Auto Adaptation")
    table.cell(t, 1, 16, "DISABLED")
    table.cell(t, 0, 17, "Auto Trading")
    table.cell(t, 1, 17, "DISABLED")

plotshape(patternDrift, title="Research Drift", style=shape.circle, location=location.abovebar, size=size.tiny, color=color.orange, text="DRIFT")
plotshape(patternRecovery, title="Research Recovery", style=shape.circle, location=location.belowbar, size=size.tiny, color=color.aqua, text="REC")
alertcondition(patternDrift, "AuctionAI Research Drift", "Research-only: pattern drift detected.")
alertcondition(patternRecovery, "AuctionAI Research Recovery", "Research-only: pattern recovery detected.")
alertcondition(researchRecommendation, "AuctionAI Research Recommendation", "Research-only: a Candidate recommendation was generated.")
