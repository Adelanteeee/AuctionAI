//@version=6
indicator("AuctionAI v1.2 - Weight Recommendation & Evidence Ranking", overlay=true, max_bars_back=5000)

// v1.2 — Weight Recommendation & Evidence Ranking Engine
// Research / recommendation only.
// Frozen decision weights are NEVER modified by this script.
// No entry, SL, TP, position sizing, execution, auto-learning, or threshold adaptation.

// ========================= INPUTS =========================
validationHorizon = input.int(5, "Validation Horizon", minval=1)
h1Bars = input.int(1, "H1 Bars", minval=1)
h3Bars = input.int(3, "H3 Bars", minval=1)
h5Bars = input.int(5, "H5 Bars", minval=1)
h10Bars = input.int(10, "H10 Bars", minval=1)
h20Bars = input.int(20, "H20 Bars", minval=1)
favorableThresholdAtr = input.float(0.50, "Favorable Threshold (ATR)", minval=0.0, step=0.05)
archiveLimit = input.int(300, "Outcome Archive Size", minval=50, maxval=500)
minResearchSamples = input.int(20, "Research Minimum Samples", minval=2, maxval=500)
recommendationMinSamples = input.int(50, "Recommendation Minimum Samples", minval=20, maxval=500)
evaluationPercent = input.int(30, "Evaluation Sample %", minval=10, maxval=50)
maxWeightDelta = input.int(1, "Maximum Recommendation Change", minval=1, maxval=3)
periodStabilityThreshold = input.float(15.0, "Stability Max Period Spread (pp)", minval=1.0, maxval=50.0)

// Frozen weights. v1.2 only recommends alternatives.
weightDelta = input.int(2, "Current Delta Weight", minval=-10, maxval=10)
weightCvd = input.int(2, "Current CVD Weight", minval=-10, maxval=10)
weightEffort = input.int(1, "Current Effort Weight", minval=-10, maxval=10)
weightResult = input.int(1, "Current Result Weight", minval=-10, maxval=10)
weightBody = input.int(1, "Current Strong Body Weight", minval=-10, maxval=10)
weightBreakout = input.int(2, "Current Breakout Weight", minval=-10, maxval=10)
weightAbsorption = input.int(-3, "Current Absorption Weight", minval=-10, maxval=10)

// ========================= MARKET PROXIES =========================
atr = ta.atr(14)
atrSafe = math.max(nz(atr, syminfo.mintick), syminfo.mintick)
barRange = high - low
body = close - open
volumeAvg = ta.sma(volume, 20)
volumeSafe = math.max(nz(volumeAvg, volume), 1.0)
prevHigh = nz(high[20], high)
prevLow = nz(low[20], low)

deltaProxy = body / atrSafe
cvdProxy = ta.ema(deltaProxy, 5)
effortRatio = volume / volumeSafe
resultRatio = math.abs(body) / atrSafe
absorptionProxy = effortRatio > 1.5 and resultRatio < 0.35
contextState = math.abs(close - nz(close[10], close)) / atrSafe > 1.5 ? "TREND" : "RANGE"

deltaAligned = body != 0
cvdAligned = (body > 0 and cvdProxy > 0) or (body < 0 and cvdProxy < 0)
effortAligned = effortRatio >= 1.0
resultAligned = body != 0 and resultRatio >= 0.5
strongBody = barRange > atrSafe * 0.75
breakoutProxy = close > prevHigh or close < prevLow

// ========================= DECISION REFERENCE =========================
strongLong = close > open and strongBody
strongShort = close < open and strongBody
candidateDirection = strongLong ? 1 : strongShort ? -1 : 0

var int nextSetupId = 0
var int decisionDirection = 0
var string decisionState = "WAIT"
var string decisionQuality = "LOW"
var string decisionConfidence = "LOW"
var string decisionHealth = "HEALTHY"

// ========================= OUTCOME ARCHIVE =========================
var array<int> aSetup = array.new_int()
var array<int> aDir = array.new_int()
var array<string> aDecision = array.new_string()
var array<string> aQuality = array.new_string()
var array<string> aConfidence = array.new_string()
var array<string> aHealth = array.new_string()
var array<string> aContext = array.new_string()
var array<bool> aDelta = array.new_bool()
var array<bool> aCvd = array.new_bool()
var array<bool> aEffort = array.new_bool()
var array<bool> aResult = array.new_bool()
var array<bool> aBody = array.new_bool()
var array<bool> aBreakout = array.new_bool()
var array<bool> aNoAbsorption = array.new_bool()
var array<bool> aRetestHold = array.new_bool()
var array<float> aH1 = array.new_float()
var array<float> aH3 = array.new_float()
var array<float> aH5 = array.new_float()
var array<float> aH10 = array.new_float()
var array<float> aH20 = array.new_float()
var array<float> aMfe = array.new_float()
var array<float> aMae = array.new_float()
var array<string> aValidation = array.new_string()
var array<string> aTiming = array.new_string()

// ========================= ACTIVE OUTCOME =========================
var bool outcomeActive = false
var int outcomeSetupId = 0
var int outcomeDirection = 0
var int outcomeStartBar = na
var float outcomeReference = na
var float outcomeMfe = 0.0
var float outcomeMae = 0.0
var float outcomeAtr = na
var float outcomeH1 = na
var float outcomeH3 = na
var float outcomeH5 = na
var float outcomeH10 = na
var float outcomeH20 = na
var bool outcomeH1Done = false
var bool outcomeH3Done = false
var bool outcomeH5Done = false
var bool outcomeH10Done = false
var bool outcomeH20Done = false
var string outcomeValidation = "PENDING"
var string outcomeTiming = "PENDING"
var string outcomeQuality = "LOW"
var string outcomeConfidence = "LOW"
var string outcomeHealth = "HEALTHY"
var string outcomeContext = "RANGE"
var bool outcomeDelta = false
var bool outcomeCvd = false
var bool outcomeEffort = false
var bool outcomeResult = false
var bool outcomeBody = false
var bool outcomeBreakout = false
var bool outcomeNoAbsorption = true

newDecision = not outcomeActive and candidateDirection != 0
if newDecision
    nextSetupId += 1
    decisionDirection := candidateDirection
    decisionState := decisionDirection > 0 ? "LONG BIAS" : "SHORT BIAS"
    decisionQuality := barRange > atrSafe ? "HIGH" : "MEDIUM"
    decisionConfidence := barRange > atrSafe * 1.25 ? "HIGH" : "MEDIUM"
    decisionHealth := "HEALTHY"
    outcomeActive := true
    outcomeSetupId := nextSetupId
    outcomeDirection := decisionDirection
    outcomeStartBar := bar_index
    outcomeReference := close
    outcomeMfe := 0.0
    outcomeMae := 0.0
    outcomeAtr := atrSafe
    outcomeH1 := na
    outcomeH3 := na
    outcomeH5 := na
    outcomeH10 := na
    outcomeH20 := na
    outcomeH1Done := false
    outcomeH3Done := false
    outcomeH5Done := false
    outcomeH10Done := false
    outcomeH20Done := false
    outcomeValidation := "PENDING"
    outcomeTiming := "PENDING"
    outcomeQuality := decisionQuality
    outcomeConfidence := decisionConfidence
    outcomeHealth := decisionHealth
    outcomeContext := contextState
    outcomeDelta := deltaAligned
    outcomeCvd := cvdAligned
    outcomeEffort := effortAligned
    outcomeResult := resultAligned
    outcomeBody := strongBody
    outcomeBreakout := breakoutProxy
    outcomeNoAbsorption := not absorptionProxy

// ========================= UPDATE / ARCHIVE =========================
if outcomeActive
    signedHigh = outcomeDirection > 0 ? high - outcomeReference : outcomeReference - low
    signedLow = outcomeDirection > 0 ? low - outcomeReference : outcomeReference - high
    outcomeMfe := math.max(outcomeMfe, signedHigh)
    outcomeMae := math.min(outcomeMae, signedLow)
    barsElapsed = bar_index - outcomeStartBar
    currentMoveAtr = (close - outcomeReference) / outcomeAtr * outcomeDirection

    if not outcomeH1Done and barsElapsed >= h1Bars
        outcomeH1 := currentMoveAtr
        outcomeH1Done := true
    if not outcomeH3Done and barsElapsed >= h3Bars
        outcomeH3 := currentMoveAtr
        outcomeH3Done := true
    if not outcomeH5Done and barsElapsed >= h5Bars
        outcomeH5 := currentMoveAtr
        outcomeH5Done := true
    if not outcomeH10Done and barsElapsed >= h10Bars
        outcomeH10 := currentMoveAtr
        outcomeH10Done := true
    if not outcomeH20Done and barsElapsed >= h20Bars
        outcomeH20 := currentMoveAtr
        outcomeH20Done := true

    if outcomeValidation == "PENDING" and barsElapsed >= validationHorizon
        outcomeValidation := currentMoveAtr >= favorableThresholdAtr ? "VALIDATED" : currentMoveAtr <= -favorableThresholdAtr ? "FAILED" : "NEUTRAL"
        outcomeTiming := outcomeValidation == "VALIDATED" ? (barsElapsed <= h3Bars ? "FAST" : "NORMAL") : outcomeValidation == "FAILED" ? "FAILED" : "NORMAL"

    archiveHorizon = math.max(math.max(math.max(math.max(h1Bars, h3Bars), h5Bars), h10Bars), h20Bars)
    shouldArchive = barsElapsed >= archiveHorizon and outcomeValidation != "PENDING"

    if shouldArchive
        array.push(aSetup, outcomeSetupId)
        array.push(aDir, outcomeDirection)
        array.push(aDecision, outcomeDirection > 0 ? "LONG BIAS" : "SHORT BIAS")
        array.push(aQuality, outcomeQuality)
        array.push(aConfidence, outcomeConfidence)
        array.push(aHealth, outcomeHealth)
        array.push(aContext, outcomeContext)
        array.push(aDelta, outcomeDelta)
        array.push(aCvd, outcomeCvd)
        array.push(aEffort, outcomeEffort)
        array.push(aResult, outcomeResult)
        array.push(aBody, outcomeBody)
        array.push(aBreakout, outcomeBreakout)
        array.push(aNoAbsorption, outcomeNoAbsorption)
        array.push(aRetestHold, na(outcomeH3) ? false : outcomeH3 > -0.25)
        array.push(aH1, outcomeH1)
        array.push(aH3, outcomeH3)
        array.push(aH5, outcomeH5)
        array.push(aH10, outcomeH10)
        array.push(aH20, outcomeH20)
        array.push(aMfe, outcomeMfe / outcomeAtr)
        array.push(aMae, outcomeMae / outcomeAtr)
        array.push(aValidation, outcomeValidation)
        array.push(aTiming, outcomeTiming)

        while array.size(aSetup) > archiveLimit
            array.shift(aSetup)
            array.shift(aDir)
            array.shift(aDecision)
            array.shift(aQuality)
            array.shift(aConfidence)
            array.shift(aHealth)
            array.shift(aContext)
            array.shift(aDelta)
            array.shift(aCvd)
            array.shift(aEffort)
            array.shift(aResult)
            array.shift(aBody)
            array.shift(aBreakout)
            array.shift(aNoAbsorption)
            array.shift(aRetestHold)
            array.shift(aH1)
            array.shift(aH3)
            array.shift(aH5)
            array.shift(aH10)
            array.shift(aH20)
            array.shift(aMfe)
            array.shift(aMae)
            array.shift(aValidation)
            array.shift(aTiming)
        outcomeActive := false

// ========================= HELPERS =========================
rate(_wins, _count) => _count > 0 ? _wins * 100.0 / _count : na
lift(_rate, _baseline) => not na(_rate) and not na(_baseline) ? _rate - _baseline : na
fmtPct(_x) => na(_x) ? "-" : str.tostring(_x, "#.0") + "%"
fmtLift(_x) => na(_x) ? "-" : (_x >= 0 ? "+" : "") + str.tostring(_x, "#.0") + " pp"

// Reliability is deliberately independent from the recommendation label.
reliability(_count, _lift, _stable, _oosLift) =>
    sampleOk = _count >= recommendationMinSamples
    strongSample = _count >= recommendationMinSamples * 2
    if not sampleOk
        "INSUFFICIENT"
    else if strongSample and _stable and not na(_oosLift) and _oosLift >= 3 and not na(_lift) and math.abs(_lift) >= 8
        "HIGH"
    else if _stable and not na(_oosLift) and _oosLift >= 0 and not na(_lift) and math.abs(_lift) >= 5
        "MEDIUM"
    else
        "LOW"

recommendation(_count, _researchRate, _researchBaseline, float _evalRate, float _evalBaseline, float _r1, float _r2, float _r3, _currentWeight, _isNegative) =>
    researchLift = lift(_researchRate, _researchBaseline)
    evalLift = lift(_evalRate, _evalBaseline)
    minPeriodRate = math.min(_r1, math.min(_r2, _r3))
    maxPeriodRate = math.max(_r1, math.max(_r2, _r3))
    stable = not na(_r1) and not na(_r2) and not na(_r3) and maxPeriodRate - minPeriodRate <= periodStabilityThreshold
    enough = _count >= recommendationMinSamples
    oosPass = not na(evalLift) and evalLift >= 3
    rel = reliability(_count, researchLift, stable, evalLift)
    strongEvidence = enough and rel == "HIGH" and not na(researchLift) and math.abs(researchLift) >= 8 and oosPass
    moderateEvidence = enough and rel != "INSUFFICIENT" and not na(researchLift) and math.abs(researchLift) >= 5 and stable and not na(evalLift) and evalLift >= 0
    dir = _isNegative ? (strongEvidence and researchLift < 0 ? -maxWeightDelta : moderateEvidence and researchLift < 0 ? -1 : 0) : (strongEvidence and researchLift > 0 ? maxWeightDelta : moderateEvidence and researchLift > 0 ? 1 : 0)
    dir := math.max(-maxWeightDelta, math.min(maxWeightDelta, dir))
    rec = _currentWeight + dir
    strength = strongEvidence ? "STRONG" : moderateEvidence ? "MODERATE" : enough ? "WEAK" : "INSUFFICIENT"
    status = strongEvidence ? "PASS" : moderateEvidence ? "CANDIDATE" : "HOLD"
    [rec, dir, strength, status, researchLift, evalLift, stable, rel]

// ========================= DATASET SPLIT =========================
N = array.size(aSetup)
evalCount = int(math.floor(N * evaluationPercent / 100.0))
researchCount = N - evalCount

researchBaseN = 0
researchBaseW = 0
evalBaseN = 0
evalBaseW = 0

// Evidence counts/rates in research sample.
dTN=0, dTW=0, cTN=0, cTW=0, eTN=0, eTW=0, rTN=0, rTW=0, bodyN=0, bodyW=0, breakN=0, breakW=0, absN=0, absW=0
cLongN=0, cLongW=0, cShortN=0, cShortW=0, cTrendN=0, cTrendW=0, cRangeN=0, cRangeW=0, cHoldN=0, cHoldW=0, cWeakN=0, cWeakW=0

// 3 real research buckets for every Evidence feature.
dR1N=0,dR1W=0,dR2N=0,dR2W=0,dR3N=0,dR3W=0
cR1N=0,cR1W=0,cR2N=0,cR2W=0,cR3N=0,cR3W=0
eR1N=0,eR1W=0,eR2N=0,eR2W=0,eR3N=0,eR3W=0
rR1N=0,rR1W=0,rR2N=0,rR2W=0,rR3N=0,rR3W=0
bR1N=0,bR1W=0,bR2N=0,bR2W=0,bR3N=0,bR3W=0
xR1N=0,xR1W=0,xR2N=0,xR2W=0,xR3N=0,xR3W=0
aR1N=0,aR1W=0,aR2N=0,aR2W=0,aR3N=0,aR3W=0

// Interactions: Delta×CVD, Delta×Result, CVD×Effort, CVD×Absorption, Retest×CVD.
dcN=0,dcW=0,drN=0,drW=0,ceN=0,ceW=0,caN=0,caW=0,hcN=0,hcW=0

if N > 0
    for i = 0 to N - 1
        v = array.get(aValidation, i)
        win = v == "VALIDATED"
        if i < researchCount
            researchBaseN += 1
            researchBaseW += win ? 1 : 0
            d = array.get(aDelta,i), c = array.get(aCvd,i), e = array.get(aEffort,i), r = array.get(aResult,i)
            b = array.get(aBody,i), br = array.get(aBreakout,i), noAbs = array.get(aNoAbsorption,i), hold = array.get(aRetestHold,i)
            dir = array.get(aDir,i), ctx = array.get(aContext,i)
            dTN += d ? 1:0, dTW += d and win ? 1:0
            cTN += c ? 1:0, cTW += c and win ? 1:0
            eTN += e ? 1:0, eTW += e and win ? 1:0
            rTN += r ? 1:0, rTW += r and win ? 1:0
            bodyN += b ? 1:0, bodyW += b and win ? 1:0
            breakN += br ? 1:0, breakW += br and win ? 1:0
            absN += not noAbs ? 1:0, absW += not noAbs and win ? 1:0
            cLongN += c and dir > 0 ? 1:0, cLongW += c and dir > 0 and win ? 1:0
            cShortN += c and dir < 0 ? 1:0, cShortW += c and dir < 0 and win ? 1:0
            cTrendN += c and ctx == "TREND" ? 1:0, cTrendW += c and ctx == "TREND" and win ? 1:0
            cRangeN += c and ctx == "RANGE" ? 1:0, cRangeW += c and ctx == "RANGE" and win ? 1:0
            cHoldN += c and hold ? 1:0, cHoldW += c and hold and win ? 1:0
            cWeakN += c and not hold ? 1:0, cWeakW += c and not hold and win ? 1:0
            dc = d and c, dr = d and r, ce = c and e, ca = c and not noAbs, hc = c and hold
            dcN += dc ? 1:0, dcW += dc and win ? 1:0
            drN += dr ? 1:0, drW += dr and win ? 1:0
            ceN += ce ? 1:0, ceW += ce and win ? 1:0
            caN += ca ? 1:0, caW += ca and win ? 1:0
            hcN += hc ? 1:0, hcW += hc and win ? 1:0
            bucket = researchCount > 0 ? math.min(2, int(math.floor(i * 3.0 / researchCount))) : 0
            if bucket == 0
                dR1N += d?1:0, dR1W += d and win?1:0, cR1N += c?1:0, cR1W += c and win?1:0, eR1N += e?1:0, eR1W += e and win?1:0, rR1N += r?1:0, rR1W += r and win?1:0, bR1N += b?1:0, bR1W += b and win?1:0, xR1N += br?1:0, xR1W += br and win?1:0, aR1N += not noAbs?1:0, aR1W += not noAbs and win?1:0
            else if bucket == 1
                dR2N += d?1:0, dR2W += d and win?1:0, cR2N += c?1:0, cR2W += c and win?1:0, eR2N += e?1:0, eR2W += e and win?1:0, rR2N += r?1:0, rR2W += r and win?1:0, bR2N += b?1:0, bR2W += b and win?1:0, xR2N += br?1:0, xR2W += br and win?1:0, aR2N += not noAbs?1:0, aR2W += not noAbs and win?1:0
            else
                dR3N += d?1:0, dR3W += d and win?1:0, cR3N += c?1:0, cR3W += c and win?1:0, eR3N += e?1:0, eR3W += e and win?1:0, rR3N += r?1:0, rR3W += r and win?1:0, bR3N += b?1:0, bR3W += b and win?1:0, xR3N += br?1:0, xR3W += br and win?1:0, aR3N += not noAbs?1:0, aR3W += not noAbs and win?1:0
        else
            evalBaseN += 1
            evalBaseW += win ? 1 : 0

researchBaseline = rate(researchBaseW,researchBaseN)
evalBaseline = rate(evalBaseW,evalBaseN)
dRate=rate(dTW,dTN), cRate=rate(cTW,cTN), eRate=rate(eTW,eTN), rRate=rate(rTW,rTN), bodyRate=rate(bodyW,bodyN), breakRate=rate(breakW,breakN), absRate=rate(absW,absN)

// ========================= EVALUATION / OOS =========================
evalDN=0,evalDW=0,evalCN=0,evalCW=0,evalEN=0,evalEW=0,evalRN=0,evalRW=0,evalBodyN=0,evalBodyW=0,evalBreakN=0,evalBreakW=0,evalAbsN=0,evalAbsW=0
if evalCount > 0
    for i = researchCount to N-1
        v=array.get(aValidation,i), win=v=="VALIDATED"
        d=array.get(aDelta,i), c=array.get(aCvd,i), e=array.get(aEffort,i), r=array.get(aResult,i), b=array.get(aBody,i), br=array.get(aBreakout,i), noAbs=array.get(aNoAbsorption,i)
        evalDN += d?1:0, evalDW += d and win?1:0
        evalCN += c?1:0, evalCW += c and win?1:0
        evalEN += e?1:0, evalEW += e and win?1:0
        evalRN += r?1:0, evalRW += r and win?1:0
        evalBodyN += b?1:0, evalBodyW += b and win?1:0
        evalBreakN += br?1:0, evalBreakW += br and win?1:0
        evalAbsN += not noAbs?1:0, evalAbsW += not noAbs and win?1:0

evalDRate=rate(evalDW,evalDN), evalCRate=rate(evalCW,evalCN), evalERate=rate(evalEW,evalEN), evalRRate=rate(evalRW,evalRN), evalBodyRate=rate(evalBodyW,evalBodyN), evalBreakRate=rate(evalBreakW,evalBreakN), evalAbsRate=rate(evalAbsW,evalAbsN)

// ========================= RECOMMENDATIONS =========================
[dRec,dDelta,dStrength,dStatus,dLift,dOos,dStable,dRel] = recommendation(dTN,dRate,researchBaseline,evalDRate,evalBaseline,rate(dR1W,dR1N),rate(dR2W,dR2N),rate(dR3W,dR3N),weightDelta,false)
[cRec,cDelta,cStrength,cStatus,cLift,cOos,cStable,cRel] = recommendation(cTN,cRate,researchBaseline,evalCRate,evalBaseline,rate(cR1W,cR1N),rate(cR2W,cR2N),rate(cR3W,cR3N),weightCvd,false)
[eRec,eDelta,eStrength,eStatus,eLift,eOos,eStable,eRel] = recommendation(eTN,eRate,researchBaseline,evalERate,evalBaseline,rate(eR1W,eR1N),rate(eR2W,eR2N),rate(eR3W,eR3N),weightEffort,false)
[rRec,rDelta,rStrength,rStatus,rLift,rOos,rStable,rRel] = recommendation(rTN,rRate,researchBaseline,evalRRate,evalBaseline,rate(rR1W,rR1N),rate(rR2W,rR2N),rate(rR3W,rR3N),weightResult,false)
[bRec,bDelta,bStrength,bStatus,bLift,bOos,bStable,bRel] = recommendation(bodyN,bodyRate,researchBaseline,evalBodyRate,evalBaseline,rate(bR1W,bR1N),rate(bR2W,bR2N),rate(bR3W,bR3N),weightBody,false)
[xRec,xDelta,xStrength,xStatus,xLift,xOos,xStable,xRel] = recommendation(breakN,breakRate,researchBaseline,evalBreakRate,evalBaseline,rate(xR1W,xR1N),rate(xR2W,xR2N),rate(xR3W,xR3N),weightBreakout,false)
[aRec,aDelta,aStrength,aStatus,aLift,aOos,aStable,aRel] = recommendation(absN,absRate,researchBaseline,evalAbsRate,evalBaseline,rate(aR1W,aR1N),rate(aR2W,aR2N),rate(aR3W,aR3N),weightAbsorption,true)

// ========================= CONDITIONAL / INTERACTION RESEARCH =========================
rateCLong = rate(cLongW,cLongN), rateCShort = rate(cShortW,cShortN), rateTrend = rate(cTrendW,cTrendN), rateRange = rate(cRangeW,cRangeN), rateHold = rate(cHoldW,cHoldN), rateWeak = rate(cWeakW,cWeakN)
cLongLift=lift(rateCLong,researchBaseline), cShortLift=lift(rateCShort,researchBaseline), trendLift=lift(rateTrend,researchBaseline), rangeLift=lift(rateRange,researchBaseline), holdLift=lift(rateHold,researchBaseline), weakLift=lift(rateWeak,researchBaseline)
interactionNames = "D×C / D×R / C×E / C×A / R×C"
dcLift=lift(rate(dcW,dcN),researchBaseline), drLift=lift(rate(drW,drN),researchBaseline), ceLift=lift(rate(ceW,ceN),researchBaseline), caLift=lift(rate(caW,caN),researchBaseline), hcLift=lift(rate(hcW,hcN),researchBaseline)

// ========================= QUALITY / CONFIDENCE CONDITIONING =========================
qHighN=0,qHighW=0,qMedN=0,qMedW=0,qLowN=0,qLowW=0
cfHighN=0,cfHighW=0,cfMedN=0,cfMedW=0,cfLowN=0,cfLowW=0
if researchCount > 0
    for i=0 to researchCount-1
        win=array.get(aValidation,i)
        q=array.get(aQuality,i), cf=array.get(aConfidence,i)
        if q=="HIGH"
            qHighN+=1, qHighW+=win=="VALIDATED"?1:0
        else if q=="MEDIUM"
            qMedN+=1, qMedW+=win=="VALIDATED"?1:0
        else
            qLowN+=1, qLowW+=win=="VALIDATED"?1:0
        if cf=="HIGH"
            cfHighN+=1, cfHighW+=win=="VALIDATED"?1:0
        else if cf=="MEDIUM"
            cfMedN+=1, cfMedW+=win=="VALIDATED"?1:0
        else
            cfLowN+=1, cfLowW+=win=="VALIDATED"?1:0
qHighRate=rate(qHighW,qHighN), qMedRate=rate(qMedW,qMedN), qLowRate=rate(qLowW,qLowN)
cfHighRate=rate(cfHighW,cfHighN), cfMedRate=rate(cfMedW,cfMedN), cfLowRate=rate(cfLowW,cfLowN)

// ========================= HUD =========================
