//@version=6
indicator("AuctionAI v0.5 - Decision Engine", overlay=true)

showPanel = input.bool(true, "Show Panel")
lookback = input.int(50, "Balance Lookback")

rangeHigh = ta.highest(high, lookback)
rangeLow = ta.lowest(low, lookback)
rangeSize = rangeHigh - rangeLow
locationScore = rangeSize != 0 ? (close-rangeLow)/rangeSize : 0.5

location = locationScore > .75 ? "UPPER VALUE" : locationScore < .25 ? "LOWER VALUE" : "MID VALUE"

breakUp = close > rangeHigh
breakDown = close < rangeLow
attempt = breakUp ? "BREAKOUT UP" : breakDown ? "BREAKOUT DOWN" : "NONE"

atr = ta.atr(14)
body = math.abs(close-open)
strongBody = body > atr * .7

acceptance = (breakUp and strongBody) or (breakDown and strongBody)
rejection = (high > rangeHigh and close < rangeHigh) or (low < rangeLow and close > rangeLow)

volumeEffort = volume > ta.sma(volume,20)
result = math.abs(close-close[1]) > atr*.5

effortResult = volumeEffort and not result ? "HIGH EFFORT LOW RESULT" : volumeEffort and result ? "EFFORT MATCHES RESULT" : "LOW PARTICIPATION"

orderFlowWarning = effortResult == "HIGH EFFORT LOW RESULT"

contextScore = 0
contextScore += acceptance ? 3 : 0
contextScore += rejection ? -2 : 0
contextScore += orderFlowWarning ? -1 : 0

decision = "WAIT"
hypothesis = "Need more information"

if acceptance and not orderFlowWarning
    decision := "ACCEPTED"
    hypothesis := "Initiative Participant Active"
else if rejection or orderFlowWarning
    decision := "CAUTION"
    hypothesis := "Responsive Participant / Absorption Risk"

var table panel = table.new(position.top_right,2,12,border_width=1)

if barstate.islast and showPanel
    table.cell(panel,0,0,"AuctionAI v0.5")
    table.cell(panel,1,0,"ACTIVE")
    table.cell(panel,0,1,"Location")
    table.cell(panel,1,1,location)
    table.cell(panel,0,2,"Attempt")
    table.cell(panel,1,2,attempt)
    table.cell(panel,0,3,"Auction")
    table.cell(panel,1,3,acceptance ? "NEW VALUE TEST" : "BALANCE AUCTION")
    table.cell(panel,0,4,"Decision")
    table.cell(panel,1,4,decision)
    table.cell(panel,0,5,"Hypothesis")
    table.cell(panel,1,5,hypothesis)
    table.cell(panel,0,6,"Context Score")
    table.cell(panel,1,6,str.tostring(contextScore))
    table.cell(panel,0,7,"Effort/Result")
    table.cell(panel,1,7,effortResult)
    table.cell(panel,0,8,"Delta")
    table.cell(panel,1,8,"Pending")
    table.cell(panel,0,9,"CVD")
    table.cell(panel,1,9,"Pending")
    table.cell(panel,0,10,"Trade")
    table.cell(panel,1,10,decision == "ACCEPTED" ? "ALLOWED" : "WAIT")
    table.cell(panel,0,11,"Risk")
    table.cell(panel,1,11,orderFlowWarning ? "ABSORPTION RISK" : "NORMAL")

plot(rangeHigh, "Balance High")
plot(rangeLow, "Balance Low")