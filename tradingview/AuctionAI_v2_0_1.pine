//@version=6
indicator("AuctionAI v2.0.1 - Controlled Self-Learning", overlay=true, max_bars_back=5000)

// v2.0.1 corrective build.
// Fixes: rejected-cycle recovery, gate sample minimums, OOS sample minimum,
// confidence calibration, outcome-aware decision comparison, decision-change
// outcome analytics, full retest-state analytics, explicit baseline/active labels,
// auditable learning-cycle history, and candidate de-duplication/fresh-recommendation gating.
// Stability is intentionally ARCHIVE-BASED, not calendar/regime-period stability.
// No entry, SL, TP, position sizing, execution or auto-trading.

// ========================= INPUTS =========================
validationHorizon = input.int(5, "Validation Horizon", minval=1)
favorableThresholdAtr = input.float(0.50, "Favorable Threshold (ATR)", minval=0.0, step=0.05)
archiveLimit = input.int(400, "Outcome Archive Size", minval=100, maxval=1000)
researchMinSamples = input.int(50, "Research Minimum Samples", minval=20, maxval=500)
shadowMinOutcomes = input.int(100, "Minimum Shadow Outcomes", minval=50, maxval=500)
shadowMaxOutcomesInput = input.int(200, "Maximum Shadow Outcomes", minval=50, maxval=500)
shadowMaxOutcomes = math.max(shadowMinOutcomes, shadowMaxOutcomesInput)
evaluationPercent = input.int(30, "Research/OOS Evaluation %", minval=20, maxval=50)
oosMinSamples = input.int(30, "Minimum OOS Samples", minval=20, maxval=200)
gateMinSamples = input.int(20, "Minimum Gate Samples", minval=10, maxval=100)
minImprovementPp = input.float(2.0, "Minimum Improvement (pp)", minval=0.0, step=0.5)
maxRegressionPp = input.float(3.0, "Maximum Allowed Regression (pp)", minval=0.0, step=0.5)
maxWeightDelta = input.int(1, "Maximum Weight Change", minval=1, maxval=1)
stabilitySpreadPp = input.float(15.0, "Maximum Archive Stability Spread (pp)", minval=1.0, maxval=50.0)
minConfidenceCalibrationLift = input.float(5.0, "Minimum Confidence Calibration Lift (pp)", minval=0.0, step=0.5)
driftWindow = input.int(40, "Recent Drift Window", minval=10, maxval=200)
driftThresholdPp = input.float(10.0, "Drift Threshold (pp)", minval=1.0, step=0.5)
learningFailureLimit = input.int(3, "Consecutive Learning Failures Before Pause", minval=1, maxval=10)

// Frozen production / baseline weights.
weightDelta = input.int(2, "Baseline Delta Weight", minval=-10, maxval=10)
weightCvd = input.int(2, "Baseline CVD Weight", minval=-10, maxval=10)
weightEffort = input.int(1, "Baseline Effort Weight", minval=-10, maxval=10)
weightResult = input.int(1, "Baseline Result Weight", minval=-10, maxval=10)
weightBody = input.int(1, "Baseline Strong Body Weight", minval=-10, maxval=10)
weightBreakout = input.int(2, "Baseline Breakout Weight", minval=-10, maxval=10)
weightAbsorption = input.int(-3, "Baseline Absorption Weight", minval=-10, maxval=10)

candidateEvidence = input.string("CVD", "v1.2 Candidate Evidence", options=["CVD", "Delta", "Effort", "Result", "Strong Body", "Breakout", "Absorption"])
requestedCandidateDelta = input.int(1, "v1.2 Recommended Weight Delta", minval=-1, maxval=1)
humanApproval = input.bool(false, "HUMAN APPROVAL: Apply Ready Candidate")
manualRollback = input.bool(false, "MANUAL ROLLBACK: Restore Previous Active Weight")

// ========================= PROXIES =========================
atr = ta.atr(14)
atrSafe = math.max(nz(atr, syminfo.mintick), syminfo.mintick)
barRange = high - low
body = close - open
volumeAvg = ta.sma(volume, 20)
volumeSafe = math.max(nz(volumeAvg, volume), 1.0)
deltaProxy = body / atrSafe
cvdProxy = ta.ema(deltaProxy, 5)
effortRatio = volume / volumeSafe
resultRatio = math.abs(body) / atrSafe
absorption = effortRatio > 1.5 and resultRatio < 0.35
context = math.abs(close - nz(close[10], close)) / atrSafe > 1.5 ? "TREND" : "RANGE"
deltaAligned = body != 0
cvdAligned = (body > 0 and cvdProxy > 0) or (body < 0 and cvdProxy < 0)
effortAligned = effortRatio >= 1.0
resultAligned = body != 0 and resultRatio >= 0.5
strongBody = barRange > atrSafe * 0.75
breakout = close > nz(high[20], high) or close < nz(low[20], low)

// ========================= HELPERS =========================
rate(_w, _n) => _n > 0 ? _w * 100.0 / _n : na
pp(_x) => na(_x) ? "-" : str.tostring(_x, "#.0") + " pp"
pct(_x) => na(_x) ? "-" : str.tostring(_x, "#.0") + "%"

scoreFor(_wd, _wc, _we, _wr, _wb, _wbr, _wa) =>
    s = 0
    s += deltaAligned ? _wd : 0
    s += cvdAligned ? _wc : 0
    s += effortAligned ? _we : 0
    s += resultAligned ? _wr : 0
    s += strongBody ? _wb : 0
    s += breakout ? _wbr : 0
    s += absorption ? _wa : 0
    s

directionFromScore(_score) => _score >= 3 ? 1 : _score <= -3 ? -1 : 0

retestState(_move, _dir) =>
    directionalMove = _dir == 0 ? 0.0 : _move * _dir
    directionalMove >= favorableThresholdAtr ? "HOLD" : directionalMove >= 0.0 ? "RECLAIM" : directionalMove > -0.25 ? "WEAK" : directionalMove > -0.50 ? "BREACH" : "FAIL"

// ========================= ACTIVE BASELINE ARCHIVE =========================
var array<int> aBar = array.new_int()
var array<int> aDir = array.new_int()
var array<string> aContext = array.new_string()
var array<string> aValidation = array.new_string()
var array<string> aRetest = array.new_string()
var array<int> aQuality = array.new_int()
var array<int> aConfidence = array.new_int()
var array<int> aHealth = array.new_int()
var array<bool> aCvd = array.new_bool()

var bool baseActive = false
var int baseDir = 0
var int baseStart = na
var float baseEntry = na
var float baseAtr = na

baseScore = scoreFor(weightDelta, weightCvd, weightEffort, weightResult, weightBody, weightBreakout, weightAbsorption)
baseCandidateDir = directionFromScore(baseScore)

if not baseActive and baseCandidateDir != 0
    baseActive := true
    baseDir := baseCandidateDir
    baseStart := bar_index
    baseEntry := close
    baseAtr := atrSafe

if baseActive
    baseBars = bar_index - baseStart
    if baseBars >= validationHorizon
        baseMove = (close - baseEntry) / baseAtr * baseDir
        baseOutcome = baseMove >= favorableThresholdAtr ? "VALIDATED" : baseMove <= -favorableThresholdAtr ? "FAILED" : "NEUTRAL"
        array.push(aBar, baseStart)
        array.push(aDir, baseDir)
        array.push(aContext, context)
        array.push(aValidation, baseOutcome)
        array.push(aRetest, retestState(baseMove, baseDir))
        array.push(aQuality, math.abs(baseScore))
        array.push(aConfidence, math.min(100, math.abs(baseScore) * 20))
        array.push(aHealth, 100)
        array.push(aCvd, cvdAligned)
        while array.size(aBar) > archiveLimit
            array.shift(aBar)
            array.shift(aDir)
            array.shift(aContext)
            array.shift(aValidation)
            array.shift(aRetest)
            array.shift(aQuality)
            array.shift(aConfidence)
            array.shift(aHealth)
            array.shift(aCvd)
        baseActive := false

// ========================= HISTORICAL RESEARCH / DRIFT =========================
N = array.size(aBar)
researchN = int(math.floor(N * (100 - evaluationPercent) / 100.0))
oosN = N - researchN
baseResearchW = 0
baseOosW = 0
recentW = 0
recentN = math.min(N, driftWindow)

if N > 0
    for i = 0 to N - 1
        win = array.get(aValidation, i) == "VALIDATED"
        if i < researchN
            baseResearchW += win ? 1 : 0
        else
            baseOosW += win ? 1 : 0
        if i >= N - recentN
            recentW += win ? 1 : 0

researchRate = rate(baseResearchW, researchN)
oosRate = rate(baseOosW, oosN)
recentRate = rate(recentW, recentN)
driftDetected = not na(researchRate) and not na(recentRate) and math.abs(recentRate - researchRate) >= driftThresholdPp

// ========================= LEARNING STATE =========================
var int cycleId = 0
var string cycleState = "IDLE"
var string cycleStatus = "NO CANDIDATE"
var int cycleStartBar = na
var int cycleEvidenceDelta = 0
var string cycleEvidence = ""
var int cycleCandidateWeight = 0
var int cycleBaselineWeight = 0
var int shadowCount = 0
var int shadowValidated = 0
var int shadowLongN = 0
var int shadowLongW = 0
var int shadowShortN = 0
var int shadowShortW = 0
var int shadowTrendN = 0
var int shadowTrendW = 0
var int shadowRangeN = 0
var int shadowRangeW = 0
var int shadowRetestN = 0
var int shadowRetestW = 0
var int shadowConfidenceN = 0
var int shadowConfidenceW = 0
var int confLowN = 0
var int confLowW = 0
var int confMidN = 0
var int confMidW = 0
var int confHighN = 0
var int confHighW = 0
var int baseCompareN = 0
var int baseCompareW = 0
var int baselineLongN = 0
var int baselineLongW = 0
var int baselineShortN = 0
var int baselineShortW = 0
var int baselineTrendN = 0
var int baselineTrendW = 0
var int baselineRangeN = 0
var int baselineRangeW = 0
var int baselineRetestN = 0
var int baselineRetestW = 0
var int changedDecisionN = 0
var int changedSuccessN = 0
var int waitToLong = 0
var int waitToLongW = 0
var int waitToShort = 0
var int waitToShortW = 0
var int longToWait = 0
var int longToWaitW = 0
var int shortToWait = 0
var int shortToWaitW = 0
var int longToShort = 0
var int longToShortW = 0
var int shortToLong = 0
var int shortToLongW = 0
var int candidateSuccess = 0
var int rejectedCandidates = 0
var int appliedCandidates = 0
var int rollbacks = 0
var int consecutiveFailures = 0
var bool learningPaused = false
var int learnedDelta = 0
var int learnedCvd = 0
var int learnedEffort = 0
var int learnedResult = 0
var int learnedBody = 0
var int learnedBreakout = 0
var int learnedAbsorption = 0
var int lastAppliedCycle = 0

// Candidate de-duplication / freshness state.
// A candidate may only be created when its recommendation signature is new
// or the underlying research evidence has materially changed since the last cycle.
var string lastCandidateEvidence = ""
var int lastCandidateDelta = na
var int lastCandidateResearchW = na
var int lastCandidateResearchN = na
var bool hasCandidateHistory = false

var bool shadowActive = false
var int shadowDir = 0
var int shadowBaseDir = 0
var int shadowStart = na
var float shadowEntry = na
var float shadowAtr = na
var string shadowCtx = "RANGE"
var bool shadowRetestHold = false
var int shadowConfidence = 0

var array<bool> shadowWins = array.new_bool()
var array<bool> shadowBaseWins = array.new_bool()
var array<int> shadowDirs = array.new_int()
var array<int> shadowBaseDirs = array.new_int()
var array<int> shadowConfidenceValues = array.new_int()
var array<string> shadowRetestStates = array.new_string()

var array<int> learningCycleIds = array.new_int()
var array<string> learningEvidence = array.new_string()
var array<int> learningFrom = array.new_int()
var array<int> learningTo = array.new_int()
var array<float> learningImprovement = array.new_float()
var array<string> learningFinalStatus = array.new_string()
var array<int> learningShadowN = array.new_int()
var array<bool> learningOosPass = array.new_bool()
var array<bool> learningRegressionFree = array.new_bool()
var array<string> learningReason = array.new_string()

if barstate.isfirst
    learnedDelta := weightDelta
    learnedCvd := weightCvd
    learnedEffort := weightEffort
    learnedResult := weightResult
    learnedBody := weightBody
    learnedBreakout := weightBreakout
    learnedAbsorption := weightAbsorption

// ========================= CANDIDATE CREATION =========================
requestedDelta = math.max(-maxWeightDelta, math.min(maxWeightDelta, requestedCandidateDelta))
currentRecommendationWeight = candidateEvidence == "CVD" ? learnedCvd : candidateEvidence == "Delta" ? learnedDelta : candidateEvidence == "Effort" ? learnedEffort : candidateEvidence == "Result" ? learnedResult : candidateEvidence == "Strong Body" ? learnedBody : candidateEvidence == "Breakout" ? learnedBreakout : learnedAbsorption
proposedRecommendationWeight = currentRecommendationWeight + requestedDelta
recommendationValid = requestedDelta != 0 and proposedRecommendationWeight != currentRecommendationWeight
researchEvidenceChanged = not hasCandidateHistory or researchN != lastCandidateResearchN or baseResearchW != lastCandidateResearchW
recommendationChanged = not hasCandidateHistory or candidateEvidence != lastCandidateEvidence or requestedDelta != lastCandidateDelta
freshRecommendation = recommendationValid and (researchEvidenceChanged or recommendationChanged)

// Research data alone is not enough: a candidate requires a valid, fresh
// recommendation. The same candidate is therefore blocked until research
// evidence or the recommendation itself changes.
candidateSupported = N >= researchMinSamples and researchN >= researchMinSamples and not learningPaused and cycleState == "IDLE" and not driftDetected and freshRecommendation

if candidateSupported
    cycleId += 1
    cycleState := "SHADOW"
    cycleStatus := "SHADOW RUNNING"
    cycleStartBar := bar_index
    cycleEvidence := candidateEvidence
    cycleEvidenceDelta := requestedDelta
    cycleBaselineWeight := currentRecommendationWeight
    cycleCandidateWeight := proposedRecommendationWeight

    // Freeze the recommendation signature for this cycle.
    lastCandidateEvidence := candidateEvidence
    lastCandidateDelta := requestedDelta
    lastCandidateResearchW := baseResearchW
    lastCandidateResearchN := researchN
    hasCandidateHistory := true

    shadowCount := 0
    shadowValidated := 0
    shadowLongN := 0
    shadowLongW := 0
    shadowShortN := 0
    shadowShortW := 0
    shadowTrendN := 0
    shadowTrendW := 0
    shadowRangeN := 0
    shadowRangeW := 0
    shadowRetestN := 0
    shadowRetestW := 0
    shadowConfidenceN := 0
    shadowConfidenceW := 0
    confLowN := 0
    confLowW := 0
    confMidN := 0
    confMidW := 0
    confHighN := 0
    confHighW := 0
    baseCompareN := 0
    baseCompareW := 0
    baselineLongN := 0
    baselineLongW := 0
    baselineShortN := 0
    baselineShortW := 0
    baselineTrendN := 0
    baselineTrendW := 0
    baselineRangeN := 0
    baselineRangeW := 0
    baselineRetestN := 0
    baselineRetestW := 0
    changedDecisionN := 0
    changedSuccessN := 0
    waitToLong := 0
    waitToLongW := 0
    waitToShort := 0
    waitToShortW := 0
    longToWait := 0
    longToWaitW := 0
    shortToWait := 0
    shortToWaitW := 0
    longToShort := 0
    longToShortW := 0
    shortToLong := 0
    shortToLongW := 0
    array.clear(shadowWins)
    array.clear(shadowBaseWins)
    array.clear(shadowDirs)
    array.clear(shadowBaseDirs)
    array.clear(shadowConfidenceValues)
    array.clear(shadowRetestStates)

// ========================= PARALLEL BASELINE / SHADOW =========================
candidateWd = cycleEvidence == "Delta" ? cycleCandidateWeight : learnedDelta
candidateWc = cycleEvidence == "CVD" ? cycleCandidateWeight : learnedCvd
candidateWe = cycleEvidence == "Effort" ? cycleCandidateWeight : learnedEffort
candidateWr = cycleEvidence == "Result" ? cycleCandidateWeight : learnedResult
candidateWb = cycleEvidence == "Strong Body" ? cycleCandidateWeight : learnedBody
candidateWbr = cycleEvidence == "Breakout" ? cycleCandidateWeight : learnedBreakout
candidateWa = cycleEvidence == "Absorption" ? cycleCandidateWeight : learnedAbsorption

if cycleState == "SHADOW" and not shadowActive and shadowCount < shadowMaxOutcomes
    bScore = scoreFor(learnedDelta, learnedCvd, learnedEffort, learnedResult, learnedBody, learnedBreakout, learnedAbsorption)
    sScore = scoreFor(candidateWd, candidateWc, candidateWe, candidateWr, candidateWb, candidateWbr, candidateWa)
    bDir = directionFromScore(bScore)
    sDir = directionFromScore(sScore)
    if bDir != 0 or sDir != 0
        shadowActive := true
        shadowDir := sDir
        shadowBaseDir := bDir
        shadowStart := bar_index
        shadowEntry := close
        shadowAtr := atrSafe
        shadowCtx := context
        shadowRetestHold := bDir != 0 or sDir != 0
        shadowConfidence := math.min(100, math.max(math.abs(bScore), math.abs(sScore)) * 20)

if cycleState == "SHADOW" and shadowActive
    sBars = bar_index - shadowStart
    if sBars >= validationHorizon
        sRawMove = (close - shadowEntry) / shadowAtr
        sMove = shadowDir == 0 ? 0.0 : sRawMove * shadowDir
        bMove = shadowBaseDir == 0 ? 0.0 : sRawMove * shadowBaseDir
        sApplicable = shadowDir != 0
        bApplicable = shadowBaseDir != 0
        sWin = sApplicable and sMove >= favorableThresholdAtr
        bWin = bApplicable and bMove >= favorableThresholdAtr
        sRetest = retestState(sRawMove, shadowDir)

        array.push(shadowWins, sWin)
        array.push(shadowBaseWins, bWin)
        array.push(shadowDirs, shadowDir)
        array.push(shadowBaseDirs, shadowBaseDir)
        array.push(shadowConfidenceValues, shadowConfidence)
        array.push(shadowRetestStates, sRetest)
        shadowCount += 1
        shadowValidated += sWin ? 1 : 0

        if shadowDir > 0
            shadowLongN += 1
            shadowLongW += sWin ? 1 : 0
        else if shadowDir < 0
            shadowShortN += 1
            shadowShortW += sWin ? 1 : 0
        if shadowCtx == "TREND"
            shadowTrendN += 1
            shadowTrendW += sWin ? 1 : 0
        else
            shadowRangeN += 1
            shadowRangeW += sWin ? 1 : 0
        if sRetest == "HOLD"
            shadowRetestN += 1
            shadowRetestW += sWin ? 1 : 0

        shadowConfidenceN += 1
        shadowConfidenceW += shadowConfidence >= 60 and sWin ? 1 : 0
        if shadowConfidence < 60
            confLowN += 1
            confLowW += sWin ? 1 : 0
        else if shadowConfidence < 80
            confMidN += 1
            confMidW += sWin ? 1 : 0
        else
            confHighN += 1
            confHighW += sWin ? 1 : 0

        if bApplicable
            baseCompareN += 1
            baseCompareW += bWin ? 1 : 0
            if shadowBaseDir > 0
                baselineLongN += 1
                baselineLongW += bWin ? 1 : 0
            else
                baselineShortN += 1
                baselineShortW += bWin ? 1 : 0
        if shadowCtx == "TREND"
            baselineTrendN += 1
            baselineTrendW += bWin ? 1 : 0
        else
            baselineRangeN += 1
            baselineRangeW += bWin ? 1 : 0
        if sRetest == "HOLD"
            baselineRetestN += 1
            baselineRetestW += bWin ? 1 : 0

        if shadowDir != shadowBaseDir
            changedDecisionN += 1
            if sWin
                changedSuccessN += 1
            if shadowBaseDir == 0 and shadowDir == 1
                waitToLong += 1
                waitToLongW += sWin ? 1 : 0
            else if shadowBaseDir == 0 and shadowDir == -1
                waitToShort += 1
                waitToShortW += sWin ? 1 : 0
            else if shadowBaseDir == 1 and shadowDir == 0
                longToWait += 1
                longToWaitW += bWin ? 1 : 0
            else if shadowBaseDir == -1 and shadowDir == 0
                shortToWait += 1
                shortToWaitW += bWin ? 1 : 0
            else if shadowBaseDir == 1 and shadowDir == -1
                longToShort += 1
                longToShortW += sWin ? 1 : 0
            else if shadowBaseDir == -1 and shadowDir == 1
                shortToLong += 1
                shortToLongW += sWin ? 1 : 0

        shadowActive := false

// ========================= SHADOW METRICS =========================
shadowRate = rate(shadowValidated, shadowCount)
baseRate = rate(baseCompareW, baseCompareN)
improvement = not na(shadowRate) and not na(baseRate) ? shadowRate - baseRate : na

shadowEvalN = int(math.floor(shadowCount * evaluationPercent / 100.0))
shadowResearchN = shadowCount - shadowEvalN
shadowResearchW = 0
shadowEvalW = 0
if shadowCount > 0
    for si = 0 to shadowCount - 1
        sw = array.get(shadowWins, si)
        if si < shadowResearchN
            shadowResearchW += sw ? 1 : 0
        else
            shadowEvalW += sw ? 1 : 0
shadowResearchRate = rate(shadowResearchW, shadowResearchN)
shadowEvalRate = rate(shadowEvalW, shadowEvalN)
shadowOosLift = not na(shadowEvalRate) and not na(shadowResearchRate) ? shadowEvalRate - shadowResearchRate : na

// Archive-segment stability: three contiguous segments of the shadow archive.
shadowB1N = 0
shadowB1W = 0
shadowB2N = 0
shadowB2W = 0
shadowB3N = 0
shadowB3W = 0
if shadowCount > 0
    for si = 0 to shadowCount - 1
        sw = array.get(shadowWins, si)
        sb = math.min(2, int(math.floor(si * 3.0 / shadowCount)))
        if sb == 0
            shadowB1N += 1
            shadowB1W += sw ? 1 : 0
        else if sb == 1
            shadowB2N += 1
            shadowB2W += sw ? 1 : 0
        else
            shadowB3N += 1
            shadowB3W += sw ? 1 : 0
shadowB1Rate = rate(shadowB1W, shadowB1N)
shadowB2Rate = rate(shadowB2W, shadowB2N)
shadowB3Rate = rate(shadowB3W, shadowB3N)
shadowMinRate = math.min(nz(shadowB1Rate, 0), math.min(nz(shadowB2Rate, 0), nz(shadowB3Rate, 0)))
shadowMaxRate = math.max(nz(shadowB1Rate, 0), math.max(nz(shadowB2Rate, 0), nz(shadowB3Rate, 0)))
shadowStabilitySpread = shadowMaxRate - shadowMinRate
shadowStable = shadowCount >= 30 and not na(shadowB1Rate) and not na(shadowB2Rate) and not na(shadowB3Rate) and shadowStabilitySpread <= stabilitySpreadPp

longShadowRate = rate(shadowLongW, shadowLongN)
longBaseRate = rate(baselineLongW, baselineLongN)
shortShadowRate = rate(shadowShortW, shadowShortN)
shortBaseRate = rate(baselineShortW, baselineShortN)
trendShadowRate = rate(shadowTrendW, shadowTrendN)
trendBaseRate = rate(baselineTrendW, baselineTrendN)
rangeShadowRate = rate(shadowRangeW, shadowRangeN)
rangeBaseRate = rate(baselineRangeW, baselineRangeN)
holdShadowRate = rate(shadowRetestW, shadowRetestN)
holdBaseRate = rate(baselineRetestW, baselineRetestN)

longRegression = not na(longShadowRate) and not na(longBaseRate) and longShadowRate - longBaseRate < -maxRegressionPp
shortRegression = not na(shortShadowRate) and not na(shortBaseRate) and shortShadowRate - shortBaseRate < -maxRegressionPp
trendRegression = not na(trendShadowRate) and not na(trendBaseRate) and trendShadowRate - trendBaseRate < -maxRegressionPp
rangeRegression = not na(rangeShadowRate) and not na(rangeBaseRate) and rangeShadowRate - rangeBaseRate < -maxRegressionPp
holdRegression = not na(holdShadowRate) and not na(holdBaseRate) and holdShadowRate - holdBaseRate < -maxRegressionPp

longGateReady = shadowLongN >= gateMinSamples and baselineLongN >= gateMinSamples
shortGateReady = shadowShortN >= gateMinSamples and baselineShortN >= gateMinSamples
directionGateReady = longGateReady and shortGateReady
directionPass = directionGateReady and not longRegression and not shortRegression

trendGateReady = shadowTrendN >= gateMinSamples and baselineTrendN >= gateMinSamples
rangeGateReady = shadowRangeN >= gateMinSamples and baselineRangeN >= gateMinSamples
contextGateReady = trendGateReady and rangeGateReady
contextPass = contextGateReady and not trendRegression and not rangeRegression

holdGateReady = shadowRetestN >= gateMinSamples and baselineRetestN >= gateMinSamples
retestPass = holdGateReady and not holdRegression

samplePass = shadowCount >= shadowMinOutcomes
oosSamplePass = shadowEvalN >= oosMinSamples
researchSamplePass = shadowResearchN >= researchMinSamples
oosPass = oosSamplePass and researchSamplePass and not na(shadowOosLift) and shadowOosLift >= minImprovementPp
stabilityPass = shadowStable
driftPass = not driftDetected

confLowRate = rate(confLowW, confLowN)
confMidRate = rate(confMidW, confMidN)
confHighRate = rate(confHighW, confHighN)
confidenceCalibrationReady = confLowN >= gateMinSamples and confHighN >= gateMinSamples
confidenceCalibrationPass = confidenceCalibrationReady and not na(confHighRate) and not na(confLowRate) and confHighRate - confLowRate >= minConfidenceCalibrationLift
confidencePass = confidenceCalibrationPass

directComparisonPass = baseCompareN >= gateMinSamples and not na(improvement) and improvement >= minImprovementPp

allGatesPass = samplePass and oosPass and stabilityPass and driftPass and directionPass and contextPass and retestPass and confidencePass and directComparisonPass
candidateReady = cycleState == "SHADOW" and shadowCount >= shadowMinOutcomes

// ========================= CYCLE FINALIZATION =========================
if candidateReady
    cycleState := allGatesPass ? "READY" : "IDLE"
    cycleStatus := allGatesPass ? "APPROVAL READY" : "REJECTED -> IDLE"
    finalStatus = allGatesPass ? "APPROVAL READY" : "REJECTED"
    reason = allGatesPass ? "All gates passed" : not samplePass ? "Shadow sample insufficient" : not oosPass ? "OOS gate failed" : not stabilityPass ? "Archive stability failed" : not directionPass ? "Direction regression/sample gate failed" : not contextPass ? "Context regression/sample gate failed" : not retestPass ? "Retest HOLD regression/sample gate failed" : not confidencePass ? "Confidence calibration failed" : not directComparisonPass ? "Outcome-aware improvement gate failed" : "Learning gate failed"
    array.push(learningCycleIds, cycleId)
    array.push(learningEvidence, cycleEvidence)
    array.push(learningFrom, cycleBaselineWeight)
    array.push(learningTo, cycleCandidateWeight)
    array.push(learningImprovement, improvement)
    array.push(learningFinalStatus, finalStatus)
    array.push(learningShadowN, shadowCount)
    array.push(learningOosPass, oosPass)
    array.push(learningRegressionFree, directionPass and contextPass and retestPass)
    array.push(learningReason, reason)
    if not allGatesPass
        rejectedCandidates += 1
        consecutiveFailures += 1
        if consecutiveFailures >= learningFailureLimit
            learningPaused := true
    else
        candidateSuccess += 1
        consecutiveFailures := 0

// ========================= HUMAN APPROVAL / APPLY / ROLLBACK =========================
if cycleState == "READY" and allGatesPass and humanApproval
    if cycleEvidence == "CVD"
        learnedCvd := cycleCandidateWeight
    else if cycleEvidence == "Delta"
        learnedDelta := cycleCandidateWeight
    else if cycleEvidence == "Effort"
        learnedEffort := cycleCandidateWeight
    else if cycleEvidence == "Result"
        learnedResult := cycleCandidateWeight
    else if cycleEvidence == "Strong Body"
        learnedBody := cycleCandidateWeight
    else if cycleEvidence == "Breakout"
        learnedBreakout := cycleCandidateWeight
    else
        learnedAbsorption := cycleCandidateWeight
    appliedCandidates += 1
    lastAppliedCycle := cycleId
    if array.size(learningFinalStatus) > 0
        array.set(learningFinalStatus, array.size(learningFinalStatus) - 1, "APPLIED")
    cycleStatus := "APPLIED"
    cycleState := "IDLE"

if manualRollback and lastAppliedCycle == cycleId and cycleId > 0
    if cycleEvidence == "CVD"
        learnedCvd := cycleBaselineWeight
    else if cycleEvidence == "Delta"
        learnedDelta := cycleBaselineWeight
    else if cycleEvidence == "Effort"
        learnedEffort := cycleBaselineWeight
    else if cycleEvidence == "Result"
        learnedResult := cycleBaselineWeight
    else if cycleEvidence == "Strong Body"
        learnedBody := cycleBaselineWeight
    else if cycleEvidence == "Breakout"
        learnedBreakout := cycleBaselineWeight
    else
        learnedAbsorption := cycleBaselineWeight
    rollbacks += 1
    if array.size(learningFinalStatus) > 0
        array.set(learningFinalStatus, array.size(learningFinalStatus) - 1, "ROLLED BACK")
    cycleStatus := "ROLLED BACK"
    cycleState := "IDLE"

// ========================= LEARNING HEALTH =========================
totalCandidates = candidateSuccess + rejectedCandidates
candidateSuccessRate = rate(candidateSuccess, totalCandidates)
rollbackRate = rate(rollbacks, appliedCandidates)
learningHealth = learningPaused ? "PAUSED" : not na(rollbackRate) and rollbackRate > 25 ? "LOW" : not na(candidateSuccessRate) and candidateSuccessRate >= 60 ? "HIGH" : "MEDIUM"

waitLongRate = rate(waitToLongW, waitToLong)
waitShortRate = rate(waitToShortW, waitToShort)
longWaitRate = rate(longToWaitW, longToWait)
shortWaitRate = rate(shortToWaitW, shortToWait)
longShortRate = rate(longToShortW, longToShort)
shortLongRate = rate(shortToLongW, shortToLong)

// ========================= HUD =========================
var table hud = table.new(position.top_right, 3, 30, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "AUCTION AI v2.0.1")
    table.cell(hud, 1, 0, "CONTROLLED SELF-LEARNING")
    table.cell(hud, 2, 0, cycleStatus)
    table.cell(hud, 0, 1, "Cycle")
    table.cell(hud, 1, 1, "LC-" + str.tostring(cycleId))
    table.cell(hud, 2, 1, cycleState)
    table.cell(hud, 0, 2, "Candidate")
    table.cell(hud, 1, 2, cycleEvidence == "" ? "-" : cycleEvidence)
    table.cell(hud, 2, 2, cycleEvidence == "" ? "-" : "Baseline " + str.tostring(cycleBaselineWeight) + " -> Candidate " + str.tostring(cycleCandidateWeight))
    table.cell(hud, 0, 3, "Shadow")
    table.cell(hud, 1, 3, str.tostring(shadowCount))
    table.cell(hud, 2, 3, "Min " + str.tostring(shadowMinOutcomes) + " / Max " + str.tostring(shadowMaxOutcomes))
    table.cell(hud, 0, 4, "Baseline vs Shadow")
    table.cell(hud, 1, 4, pct(baseRate) + " / " + pct(shadowRate))
    table.cell(hud, 2, 4, "Δ " + pp(improvement))
    table.cell(hud, 0, 5, "OOS")
    table.cell(hud, 1, 5, pp(shadowOosLift))
    table.cell(hud, 2, 5, oosPass ? "PASS" : "FAIL")
    table.cell(hud, 0, 6, "LONG")
    table.cell(hud, 1, 6, pct(longShadowRate))
    table.cell(hud, 2, 6, longGateReady ? (longRegression ? "REGRESSION" : "PASS") : "NOT ENOUGH DATA")
    table.cell(hud, 0, 7, "SHORT")
    table.cell(hud, 1, 7, pct(shortShadowRate))
    table.cell(hud, 2, 7, shortGateReady ? (shortRegression ? "REGRESSION" : "PASS") : "NOT ENOUGH DATA")
    table.cell(hud, 0, 8, "TREND")
    table.cell(hud, 1, 8, pct(trendShadowRate))
    table.cell(hud, 2, 8, trendGateReady ? (trendRegression ? "REGRESSION" : "PASS") : "NOT ENOUGH DATA")
    table.cell(hud, 0, 9, "RANGE")
    table.cell(hud, 1, 9, pct(rangeShadowRate))
    table.cell(hud, 2, 9, rangeGateReady ? (rangeRegression ? "REGRESSION" : "PASS") : "NOT ENOUGH DATA")
    table.cell(hud, 0, 10, "RETEST HOLD")
    table.cell(hud, 1, 10, pct(holdShadowRate))
    table.cell(hud, 2, 10, holdGateReady ? (holdRegression ? "REGRESSION" : "PASS") : "NOT ENOUGH DATA")
    table.cell(hud, 0, 11, "Retest Lifecycle")
    table.cell(hud, 1, 11, "HOLD/RECLAIM/WEAK/BREACH/FAIL")
    table.cell(hud, 2, 11, "Tracked")
    table.cell(hud, 0, 12, "Confidence")
    table.cell(hud, 1, 12, "L " + pct(confLowRate) + " / H " + pct(confHighRate))
    table.cell(hud, 2, 12, confidencePass ? "CALIBRATED" : "FAIL")
    table.cell(hud, 0, 13, "Stability")
    table.cell(hud, 1, 13, shadowStable ? "HIGH" : "LOW")
    table.cell(hud, 2, 13, "Archive-based")
    table.cell(hud, 0, 14, "Drift")
    table.cell(hud, 1, 14, driftDetected ? "POSSIBLE" : "NONE")
    table.cell(hud, 2, 14, driftPass ? "PASS" : "FREEZE")
    table.cell(hud, 0, 15, "Decision Changes")
    table.cell(hud, 1, 15, str.tostring(changedDecisionN) + " / " + str.tostring(shadowCount))
    table.cell(hud, 2, 15, "Outcome-aware")
    table.cell(hud, 0, 16, "WAIT -> LONG")
    table.cell(hud, 1, 16, str.tostring(waitToLong))
    table.cell(hud, 2, 16, pct(waitLongRate))
    table.cell(hud, 0, 17, "WAIT -> SHORT")
    table.cell(hud, 1, 17, str.tostring(waitToShort))
    table.cell(hud, 2, 17, pct(waitShortRate))
    table.cell(hud, 0, 18, "LONG -> WAIT")
    table.cell(hud, 1, 18, str.tostring(longToWait))
    table.cell(hud, 2, 18, pct(longWaitRate))
    table.cell(hud, 0, 19, "SHORT -> WAIT")
    table.cell(hud, 1, 19, str.tostring(shortToWait))
    table.cell(hud, 2, 19, pct(shortWaitRate))
    table.cell(hud, 0, 20, "LONG <-> SHORT")
    table.cell(hud, 1, 20, str.tostring(longToShort) + " / " + str.tostring(shortToLong))
    table.cell(hud, 2, 20, pct(rate(longToShortW + shortToLongW, longToShort + shortToLong)))
    table.cell(hud, 0, 21, "Gates")
    table.cell(hud, 1, 21, allGatesPass ? "ALL PASS" : "NOT PASS")
    table.cell(hud, 2, 21, candidateReady ? cycleStatus : "RUNNING")
    table.cell(hud, 0, 22, "Approval")
    table.cell(hud, 1, 22, humanApproval ? "ON" : "REQUIRED")
    table.cell(hud, 2, 22, cycleState == "READY" and allGatesPass ? "APPLY ELIGIBLE" : "-")
    table.cell(hud, 0, 23, "Learning Health")
    table.cell(hud, 1, 23, learningHealth)
    table.cell(hud, 2, 23, "Rollbacks " + str.tostring(rollbacks))
    table.cell(hud, 0, 24, "Research/OOS")
    table.cell(hud, 1, 24, str.tostring(shadowResearchN) + " / " + str.tostring(shadowEvalN))
    table.cell(hud, 2, 24, oosSamplePass ? "SAMPLE PASS" : "OOS SAMPLE LOW")
    table.cell(hud, 0, 25, "Active CVD")
    table.cell(hud, 1, 25, str.tostring(learnedCvd))
    table.cell(hud, 2, 25, "Baseline " + str.tostring(weightCvd))
    table.cell(hud, 0, 26, "Active Delta")
    table.cell(hud, 1, 26, str.tostring(learnedDelta))
    table.cell(hud, 2, 26, "Baseline " + str.tostring(weightDelta))
    table.cell(hud, 0, 27, "Learning History")
    table.cell(hud, 1, 27, str.tostring(array.size(learningCycleIds)))
    table.cell(hud, 2, 27, "Audit rows")
    table.cell(hud, 0, 28, "Scope")
    table.cell(hud, 1, 28, "ONE WEIGHT / CYCLE")
    table.cell(hud, 2, 28, "NO AUTO-TRADE")
    table.cell(hud, 0, 29, "Stability Definition")
    table.cell(hud, 1, 29, "Archive segments")
    table.cell(hud, 2, 29, "Not calendar periods")