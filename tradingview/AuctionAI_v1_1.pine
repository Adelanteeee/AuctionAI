//@version=6
indicator("AuctionAI v1.1 - Pattern Evaluation & Evidence Weight Research", overlay=true, max_bars_back=5000)

// v1.1 — Pattern Evaluation & Evidence Weight Research
// Research only. No automatic weight/threshold changes, ML, execution or trading.
// Outcome is price behavior after a Decision reference, not P&L.

// ========================= INPUTS =========================
validationHorizon = input.int(5, "Validation Horizon", minval=1)
h1Bars = input.int(1, "H1 Bars", minval=1)
h3Bars = input.int(3, "H3 Bars", minval=1)
h5Bars = input.int(5, "H5 Bars", minval=1)
h10Bars = input.int(10, "H10 Bars", minval=1)
h20Bars = input.int(20, "H20 Bars", minval=1)
favorableThresholdAtr = input.float(0.50, "Favorable Threshold (ATR)", minval=0.0, step=0.05)
neutralThresholdAtr = input.float(0.10, "Neutral Threshold (ATR)", minval=0.0, step=0.05)
slowValidationBars = input.int(10, "Slow Validation Bars", minval=1)
archiveLimit = input.int(300, "Outcome Archive Size", minval=20, maxval=500)
minSamples = input.int(20, "Minimum Research Samples", minval=2, maxval=500)
evaluationPercent = input.int(30, "Evaluation Sample %", minval=10, maxval=50)

// ========================= MARKET PROXIES =========================
atr = ta.atr(14)
atrSafe = math.max(nz(atr, syminfo.mintick), syminfo.mintick)
barRange = high - low
body = close - open
volumeAvg = ta.sma(volume, 20)
volumeSafe = math.max(nz(volumeAvg, volume), 1.0)

deltaProxy = body / atrSafe
cvdProxy = ta.ema(deltaProxy, 5)
effortRatio = volume / volumeSafe
resultRatio = math.abs(body) / atrSafe
absorptionProxy = effortRatio > 1.5 and resultRatio < 0.35
contextState = math.abs(close - nz(close[10], close)) / atrSafe > 1.5 ? "TREND" : "RANGE"

deltaAligned = body != 0
cvdAligned = (body > 0 and cvdProxy > 0) or (body < 0 and cvdProxy < 0)
effortAligned = effortRatio >= 1.0
resultAligned = body != 0 and resultRatio >= 0.5

// ========================= DECISION REFERENCE =========================
// Compatibility layer for a standalone v1.1 research script.
// A new reference is created only when no prior outcome is being tracked.
strongLong = close > open and barRange > atrSafe * 0.75
strongShort = close < open and barRange > atrSafe * 0.75
candidateDirection = strongLong ? 1 : strongShort ? -1 : 0

var int nextSetupId = 0
var int decisionDirection = 0
var string decisionState = "WAIT"
var string decisionQuality = "LOW"
var string decisionConfidence = "LOW"
var string decisionHealth = "HEALTHY"

// ========================= OUTCOME ARCHIVE =========================
var array<int> aSetup = array.new_int()
var array<int> aDir = array.new_int()
var array<string> aDecision = array.new_string()
var array<string> aQuality = array.new_string()
var array<string> aConfidence = array.new_string()
var array<string> aHealth = array.new_string()
var array<string> aContext = array.new_string()
var array<bool> aDelta = array.new_bool()
var array<bool> aCvd = array.new_bool()
var array<bool> aEffort = array.new_bool()
var array<bool> aResult = array.new_bool()
var array<bool> aNoAbsorption = array.new_bool()
var array<bool> aRetestHold = array.new_bool()
var array<float> aH1 = array.new_float()
var array<float> aH3 = array.new_float()
var array<float> aH5 = array.new_float()
var array<float> aH10 = array.new_float()
var array<float> aH20 = array.new_float()
var array<float> aMfe = array.new_float()
var array<float> aMae = array.new_float()
var array<string> aValidation = array.new_string()
var array<string> aTiming = array.new_string()

// ========================= ACTIVE OUTCOME =========================
var bool outcomeActive = false
var int outcomeSetupId = 0
var int outcomeDirection = 0
var int outcomeStartBar = na
var float outcomeReference = na
var float outcomeMfe = 0.0
var float outcomeMae = 0.0
var float outcomeAtr = na
var float outcomeH1 = na
var float outcomeH3 = na
var float outcomeH5 = na
var float outcomeH10 = na
var float outcomeH20 = na
var bool outcomeH1Done = false
var bool outcomeH3Done = false
var bool outcomeH5Done = false
var bool outcomeH10Done = false
var bool outcomeH20Done = false
var string outcomeValidation = "PENDING"
var string outcomeTiming = "PENDING"
var string outcomeQuality = "LOW"
var string outcomeConfidence = "LOW"
var string outcomeHealth = "HEALTHY"
var string outcomeContext = "RANGE"
var bool outcomeDelta = false
var bool outcomeCvd = false
var bool outcomeEffort = false
var bool outcomeResult = false
var bool outcomeNoAbsorption = true

// ========================= START NEW OUTCOME =========================
newDecision = not outcomeActive and candidateDirection != 0
if newDecision
    nextSetupId += 1
    decisionDirection := candidateDirection
    decisionState := decisionDirection > 0 ? "LONG BIAS" : "SHORT BIAS"
    decisionQuality := barRange > atrSafe ? "HIGH" : "MEDIUM"
    decisionConfidence := barRange > atrSafe * 1.25 ? "HIGH" : "MEDIUM"
    decisionHealth := "HEALTHY"

    outcomeActive := true
    outcomeSetupId := nextSetupId
    outcomeDirection := decisionDirection
    outcomeStartBar := bar_index
    outcomeReference := close
    outcomeMfe := 0.0
    outcomeMae := 0.0
    outcomeAtr := atrSafe
    outcomeH1 := na
    outcomeH3 := na
    outcomeH5 := na
    outcomeH10 := na
    outcomeH20 := na
    outcomeH1Done := false
    outcomeH3Done := false
    outcomeH5Done := false
    outcomeH10Done := false
    outcomeH20Done := false
    outcomeValidation := "PENDING"
    outcomeTiming := "PENDING"
    outcomeQuality := decisionQuality
    outcomeConfidence := decisionConfidence
    outcomeHealth := decisionHealth
    outcomeContext := contextState
    outcomeDelta := deltaAligned
    outcomeCvd := cvdAligned
    outcomeEffort := effortAligned
    outcomeResult := resultAligned
    outcomeNoAbsorption := not absorptionProxy

// ========================= UPDATE ACTIVE OUTCOME =========================
if outcomeActive
    signedHigh = outcomeDirection > 0 ? high - outcomeReference : outcomeReference - low
    signedLow = outcomeDirection > 0 ? low - outcomeReference : outcomeReference - high
    outcomeMfe := math.max(outcomeMfe, signedHigh)
    outcomeMae := math.min(outcomeMae, signedLow)

    barsElapsed = bar_index - outcomeStartBar
    currentMoveAtr = (close - outcomeReference) / outcomeAtr * outcomeDirection

    if not outcomeH1Done and barsElapsed >= h1Bars
        outcomeH1 := currentMoveAtr
        outcomeH1Done := true
    if not outcomeH3Done and barsElapsed >= h3Bars
        outcomeH3 := currentMoveAtr
        outcomeH3Done := true
    if not outcomeH5Done and barsElapsed >= h5Bars
        outcomeH5 := currentMoveAtr
        outcomeH5Done := true
    if not outcomeH10Done and barsElapsed >= h10Bars
        outcomeH10 := currentMoveAtr
        outcomeH10Done := true
    if not outcomeH20Done and barsElapsed >= h20Bars
        outcomeH20 := currentMoveAtr
        outcomeH20Done := true

    // Validation is recorded once. It is independent from the H20 archive horizon.
    if outcomeValidation == "PENDING" and barsElapsed >= validationHorizon
        outcomeValidation := currentMoveAtr >= favorableThresholdAtr ? "VALIDATED" : currentMoveAtr <= -favorableThresholdAtr ? "FAILED" : "NEUTRAL"
        outcomeTiming := outcomeValidation == "VALIDATED" ? (barsElapsed <= h3Bars ? "FAST" : barsElapsed <= slowValidationBars ? "NORMAL" : "SLOW") : outcomeValidation == "FAILED" ? "FAILED" : "NORMAL"

    // Archive only a completed record. If H20 is disabled by input, use the furthest configured horizon.
    archiveHorizon = math.max(math.max(math.max(math.max(h1Bars, h3Bars), h5Bars), h10Bars), h20Bars)
    shouldArchive = barsElapsed >= archiveHorizon and outcomeValidation != "PENDING"

    if shouldArchive
        array.push(aSetup, outcomeSetupId)
        array.push(aDir, outcomeDirection)
        array.push(aDecision, outcomeDirection > 0 ? "LONG BIAS" : "SHORT BIAS")
        array.push(aQuality, outcomeQuality)
        array.push(aConfidence, outcomeConfidence)
        array.push(aHealth, outcomeHealth)
        array.push(aContext, outcomeContext)
        array.push(aDelta, outcomeDelta)
        array.push(aCvd, outcomeCvd)
        array.push(aEffort, outcomeEffort)
        array.push(aResult, outcomeResult)
        array.push(aNoAbsorption, outcomeNoAbsorption)
        array.push(aRetestHold, na(outcomeH3) ? false : outcomeH3 > -0.25)
        array.push(aH1, outcomeH1)
        array.push(aH3, outcomeH3)
        array.push(aH5, outcomeH5)
        array.push(aH10, outcomeH10)
        array.push(aH20, outcomeH20)
        array.push(aMfe, outcomeMfe / outcomeAtr)
        array.push(aMae, outcomeMae / outcomeAtr)
        array.push(aValidation, outcomeValidation)
        array.push(aTiming, outcomeTiming)

        while array.size(aSetup) > archiveLimit
            array.shift(aSetup)
            array.shift(aDir)
            array.shift(aDecision)
            array.shift(aQuality)
            array.shift(aConfidence)
            array.shift(aHealth)
            array.shift(aContext)
            array.shift(aDelta)
            array.shift(aCvd)
            array.shift(aEffort)
            array.shift(aResult)
            array.shift(aNoAbsorption)
            array.shift(aRetestHold)
            array.shift(aH1)
            array.shift(aH3)
            array.shift(aH5)
            array.shift(aH10)
            array.shift(aH20)
            array.shift(aMfe)
            array.shift(aMae)
            array.shift(aValidation)
            array.shift(aTiming)

        outcomeActive := false

// ========================= HELPERS =========================
rate(_wins, _count) => _count > 0 ? _wins * 100.0 / _count : na
lift(_rate, _baseline) => not na(_rate) and not na(_baseline) ? _rate - _baseline : na
fmtPct(_x) => na(_x) ? "-" : str.tostring(_x, "#.0") + "%"
fmtLift(_x) => na(_x) ? "-" : (_x >= 0 ? "+" : "") + str.tostring(_x, "#.0") + " pp"

reliability(_count, _rate, _baseline) =>
    na(_rate) or na(_baseline) ? "INSUFFICIENT" : _count < minSamples ? "INSUFFICIENT" : _count >= minSamples * 4 and math.abs(_rate - _baseline) >= 10 ? "HIGH" : _count >= minSamples * 2 and math.abs(_rate - _baseline) >= 5 ? "MEDIUM" : "LOW"

// ========================= DATASET SPLIT =========================
N = array.size(aSetup)
evalCount = int(math.floor(N * evaluationPercent / 100.0))
researchCount = N - evalCount

baseWins = 0
baseN = 0

// Single evidence buckets: TRUE and FALSE are both measured.
dTrueN = 0
dTrueW = 0
dFalseN = 0
dFalseW = 0
cTrueN = 0
cTrueW = 0
cFalseN = 0
cFalseW = 0
eTrueN = 0
eTrueW = 0
eFalseN = 0
eFalseW = 0
rTrueN = 0
rTrueW = 0
rFalseN = 0
rFalseW = 0
noAbsN = 0
noAbsW = 0
absN = 0
absW = 0

// Interactions.
dcN = 0
dcW = 0
drN = 0
drW = 0
caN = 0
caW = 0
crN = 0
crW = 0

// Context and retest conditioning.
trendN = 0
trendW = 0
rangeN = 0
rangeW = 0
holdN = 0
holdW = 0
weakN = 0
weakW = 0

// Chronological stability buckets for Delta.
dR1N = 0
dR1W = 0
dR2N = 0
dR2W = 0
dR3N = 0
dR3W = 0

if N > 0 and researchCount > 0
    for i = 0 to N - 1
        if i < researchCount
            v = array.get(aValidation, i)
            win = v == "VALIDATED"
            baseN += 1
            baseWins += win ? 1 : 0

            d = array.get(aDelta, i)
            c = array.get(aCvd, i)
            e = array.get(aEffort, i)
            r = array.get(aResult, i)
            noAbs = array.get(aNoAbsorption, i)
            hold = array.get(aRetestHold, i)
            ctx = array.get(aContext, i)

            dTrueN += d ? 1 : 0
            dTrueW += d and win ? 1 : 0
            dFalseN += not d ? 1 : 0
            dFalseW += not d and win ? 1 : 0
            cTrueN += c ? 1 : 0
            cTrueW += c and win ? 1 : 0
            cFalseN += not c ? 1 : 0
            cFalseW += not c and win ? 1 : 0
            eTrueN += e ? 1 : 0
            eTrueW += e and win ? 1 : 0
            eFalseN += not e ? 1 : 0
            eFalseW += not e and win ? 1 : 0
            rTrueN += r ? 1 : 0
            rTrueW += r and win ? 1 : 0
            rFalseN += not r ? 1 : 0
            rFalseW += not r and win ? 1 : 0
            noAbsN += noAbs ? 1 : 0
            noAbsW += noAbs and win ? 1 : 0
            absN += not noAbs ? 1 : 0
            absW += not noAbs and win ? 1 : 0

            dc = d and c
            dr = d and r
            ca = c and not noAbs
            cr = c and r
            dcN += dc ? 1 : 0
            dcW += dc and win ? 1 : 0
            drN += dr ? 1 : 0
            drW += dr and win ? 1 : 0
            caN += ca ? 1 : 0
            caW += ca and win ? 1 : 0
            crN += cr ? 1 : 0
            crW += cr and win ? 1 : 0

            trendN += ctx == "TREND" ? 1 : 0
            trendW += ctx == "TREND" and win ? 1 : 0
            rangeN += ctx == "RANGE" ? 1 : 0
            rangeW += ctx == "RANGE" and win ? 1 : 0
            holdN += hold ? 1 : 0
            holdW += hold and win ? 1 : 0
            weakN += not hold ? 1 : 0
            weakW += not hold and win ? 1 : 0

            third = int(math.floor(i * 3.0 / researchCount))
            if third <= 0
                dR1N += d ? 1 : 0
                dR1W += d and win ? 1 : 0
            else if third == 1
                dR2N += d ? 1 : 0
                dR2W += d and win ? 1 : 0
            else
                dR3N += d ? 1 : 0
                dR3W += d and win ? 1 : 0

baselineRate = rate(baseWins, baseN)
dTrueRate = rate(dTrueW, dTrueN)
dFalseRate = rate(dFalseW, dFalseN)
cTrueRate = rate(cTrueW, cTrueN)
cFalseRate = rate(cFalseW, cFalseN)
eTrueRate = rate(eTrueW, eTrueN)
eFalseRate = rate(eFalseW, eFalseN)
rTrueRate = rate(rTrueW, rTrueN)
rFalseRate = rate(rFalseW, rFalseN)
noAbsRate = rate(noAbsW, noAbsN)
absRate = rate(absW, absN)
dcRate = rate(dcW, dcN)
drRate = rate(drW, drN)
caRate = rate(caW, caN)
crRate = rate(crW, crN)
trendRate = rate(trendW, trendN)
rangeRate = rate(rangeW, rangeN)
holdRate = rate(holdW, holdN)
weakRate = rate(weakW, weakN)

dTrueLift = lift(dTrueRate, baselineRate)
dFalseLift = lift(dFalseRate, baselineRate)
cTrueLift = lift(cTrueRate, baselineRate)
cFalseLift = lift(cFalseRate, baselineRate)
eTrueLift = lift(eTrueRate, baselineRate)
eFalseLift = lift(eFalseRate, baselineRate)
rTrueLift = lift(rTrueRate, baselineRate)
rFalseLift = lift(rFalseRate, baselineRate)
noAbsLift = lift(noAbsRate, baselineRate)
absPenalty = lift(absRate, baselineRate)

// ========================= OUT-OF-SAMPLE =========================
evalN = 0
evalWins = 0
if evalCount > 0
    for i = researchCount to N - 1
        evalN += 1
        evalWins += array.get(aValidation, i) == "VALIDATED" ? 1 : 0
evalRate = rate(evalWins, evalN)

// ========================= HUD =========================
var table hud = table.new(position.top_right, 4, 21)

if barstate.islast
    table.clear(hud, 0, 0, 3, 20)
    table.cell(hud, 0, 0, "AUCTION AI v1.1")
    table.cell(hud, 1, 0, "EVIDENCE RESEARCH")
    table.cell(hud, 2, 0, "N=" + str.tostring(N))
    table.cell(hud, 3, 0, "MIN=" + str.tostring(minSamples))

    table.cell(hud, 0, 1, "BASELINE")
    table.cell(hud, 1, 1, fmtPct(baselineRate))
    table.cell(hud, 2, 1, "OOS")
    table.cell(hud, 3, 1, fmtPct(evalRate))

    table.cell(hud, 0, 2, "DELTA +")
    table.cell(hud, 1, 2, str.tostring(dTrueN) + " | " + fmtLift(dTrueLift))
    table.cell(hud, 2, 2, reliability(dTrueN, dTrueRate, baselineRate))
    table.cell(hud, 3, 2, "Rate " + fmtPct(dTrueRate))

    table.cell(hud, 0, 3, "DELTA -")
    table.cell(hud, 1, 3, str.tostring(dFalseN) + " | " + fmtLift(dFalseLift))
    table.cell(hud, 2, 3, reliability(dFalseN, dFalseRate, baselineRate))
    table.cell(hud, 3, 3, "Rate " + fmtPct(dFalseRate))

    table.cell(hud, 0, 4, "CVD +")
    table.cell(hud, 1, 4, str.tostring(cTrueN) + " | " + fmtLift(cTrueLift))
    table.cell(hud, 2, 4, reliability(cTrueN, cTrueRate, baselineRate))
    table.cell(hud, 3, 4, "Rate " + fmtPct(cTrueRate))

    table.cell(hud, 0, 5, "CVD -")
    table.cell(hud, 1, 5, str.tostring(cFalseN) + " | " + fmtLift(cFalseLift))
    table.cell(hud, 2, 5, reliability(cFalseN, cFalseRate, baselineRate))
    table.cell(hud, 3, 5, "Rate " + fmtPct(cFalseRate))

    table.cell(hud, 0, 6, "EFFORT +")
    table.cell(hud, 1, 6, str.tostring(eTrueN) + " | " + fmtLift(eTrueLift))
    table.cell(hud, 2, 6, reliability(eTrueN, eTrueRate, baselineRate))
    table.cell(hud, 3, 6, "Rate " + fmtPct(eTrueRate))

    table.cell(hud, 0, 7, "RESULT +")
    table.cell(hud, 1, 7, str.tostring(rTrueN) + " | " + fmtLift(rTrueLift))
    table.cell(hud, 2, 7, reliability(rTrueN, rTrueRate, baselineRate))
    table.cell(hud, 3, 7, "Rate " + fmtPct(rTrueRate))

    table.cell(hud, 0, 8, "NO ABSORPTION")
    table.cell(hud, 1, 8, str.tostring(noAbsN) + " | " + fmtLift(noAbsLift))
    table.cell(hud, 2, 8, reliability(noAbsN, noAbsRate, baselineRate))
    table.cell(hud, 3, 8, "Rate " + fmtPct(noAbsRate))

    table.cell(hud, 0, 9, "ABSORPTION")
    table.cell(hud, 1, 9, str.tostring(absN) + " | " + fmtLift(absPenalty))
    table.cell(hud, 2, 9, reliability(absN, absRate, baselineRate))
    table.cell(hud, 3, 9, "Rate " + fmtPct(absRate))

    table.cell(hud, 0, 10, "DELTA × CVD")
    table.cell(hud, 1, 10, str.tostring(dcN) + " | " + fmtLift(lift(dcRate, baselineRate)))
    table.cell(hud, 2, 10, reliability(dcN, dcRate, baselineRate))
    table.cell(hud, 3, 10, "Rate " + fmtPct(dcRate))

    table.cell(hud, 0, 11, "DELTA × RESULT")
    table.cell(hud, 1, 11, str.tostring(drN) + " | " + fmtLift(lift(drRate, baselineRate)))
    table.cell(hud, 2, 11, reliability(drN, drRate, baselineRate))
    table.cell(hud, 3, 11, "Rate " + fmtPct(drRate))

    table.cell(hud, 0, 12, "CVD × ABS")
    table.cell(hud, 1, 12, str.tostring(caN) + " | " + fmtLift(lift(caRate, baselineRate)))
    table.cell(hud, 2, 12, reliability(caN, caRate, baselineRate))
    table.cell(hud, 3, 12, "Rate " + fmtPct(caRate))

    table.cell(hud, 0, 13, "CVD × RESULT")
    table.cell(hud, 1, 13, str.tostring(crN) + " | " + fmtLift(lift(crRate, baselineRate)))
    table.cell(hud, 2, 13, reliability(crN, crRate, baselineRate))
    table.cell(hud, 3, 13, "Rate " + fmtPct(crRate))

    table.cell(hud, 0, 14, "TREND")
    table.cell(hud, 1, 14, str.tostring(trendN) + " | " + fmtPct(trendRate))
    table.cell(hud, 2, 14, reliability(trendN, trendRate, baselineRate))

    table.cell(hud, 0, 15, "RANGE")
    table.cell(hud, 1, 15, str.tostring(rangeN) + " | " + fmtPct(rangeRate))
    table.cell(hud, 2, 15, reliability(rangeN, rangeRate, baselineRate))

    table.cell(hud, 0, 16, "RETEST HOLD")
    table.cell(hud, 1, 16, str.tostring(holdN) + " | " + fmtPct(holdRate))
    table.cell(hud, 2, 16, reliability(holdN, holdRate, baselineRate))

    table.cell(hud, 0, 17, "RETEST WEAK")
    table.cell(hud, 1, 17, str.tostring(weakN) + " | " + fmtPct(weakRate))
    table.cell(hud, 2, 17, reliability(weakN, weakRate, baselineRate))

    table.cell(hud, 0, 18, "RESEARCH")
    table.cell(hud, 1, 18, str.tostring(researchCount) + " samples")
    table.cell(hud, 2, 18, "OOS " + str.tostring(evalN))

    table.cell(hud, 0, 19, "STATUS")
    table.cell(hud, 1, 19, "AUDIT / RESEARCH")
    table.cell(hud, 2, 19, "NO AUTO WEIGHT")

    table.cell(hud, 0, 20, "OUTCOME")
    table.cell(hud, 1, 20, outcomeActive ? "TRACKING #" + str.tostring(outcomeSetupId) : "IDLE")
    table.cell(hud, 2, 20, outcomeValidation)

plot(outcomeActive ? outcomeReference : na, "Decision Reference", color=color.new(color.gray, 0), linewidth=1, style=plot.style_linebr)
