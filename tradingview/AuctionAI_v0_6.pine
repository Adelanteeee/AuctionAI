//@version=6
indicator("AuctionAI v0.6 - Full Auction Engine", overlay=true)

lookback=input.int(50,"Balance Lookback")
show=input.bool(true,"Show Panel")

highRange=ta.highest(high,lookback)
lowRange=ta.lowest(low,lookback)
size=highRange-lowRange
pos=size!=0?(close-lowRange)/size:0.5

location=pos>0.75?"UPPER VALUE":pos<0.25?"LOWER VALUE":"MID VALUE"

attempt=close>highRange?"BREAKOUT UP":close<lowRange?"BREAKOUT DOWN":"NONE"

atr=ta.atr(14)
body=math.abs(close-open)
strongBody=body>atr*0.7

acceptUp=close>highRange and strongBody and close>open
acceptDown=close<lowRange and strongBody and close<open

rejection= (high>highRange and close<highRange) or (low<lowRange and close>lowRange)

auction=acceptUp?"NEW VALUE HIGHER":acceptDown?"NEW VALUE LOWER":rejection?"FAILED AUCTION":"BALANCE AUCTION"
decision=acceptUp or acceptDown?"ACCEPTED":rejection?"REJECTION":"WAITING"
hypothesis=acceptUp?"Initiative Buyer":acceptDown?"Initiative Seller":rejection?"Responsive Participant":"Searching"

volumeEffort=volume>ta.sma(volume,20)
result=math.abs(close-close[1])>atr*0.5

effortResult=volumeEffort and result?"HIGH EFFORT HIGH RESULT":volumeEffort and not result?"HIGH EFFORT LOW RESULT":"LOW EFFORT"

absorption=(volumeEffort and not result)?"Possible Absorption":"No Absorption"

deltaProxy=(close-open)/atr*100
cvdBias=ta.sma(deltaProxy,10)>ta.sma(deltaProxy,30)?"RISING":"WEAKENING"

tradeState=(decision=="ACCEPTED" and absorption=="No Absorption")?"ALLOWED": "WAIT"

var table t=table.new(position.top_right,2,16)
if barstate.islast and show
    table.cell(t,0,0,"AuctionAI v0.6")
    table.cell(t,1,0,"ACTIVE")
    table.cell(t,0,1,"Location")
    table.cell(t,1,1,location)
    table.cell(t,0,2,"Attempt")
    table.cell(t,1,2,attempt)
    table.cell(t,0,3,"Auction")
    table.cell(t,1,3,auction)
    table.cell(t,0,4,"Decision")
    table.cell(t,1,4,decision)
    table.cell(t,0,5,"Hypothesis")
    table.cell(t,1,5,hypothesis)
    table.cell(t,0,6,"Effort/Result")
    table.cell(t,1,6,effortResult)
    table.cell(t,0,7,"Absorption")
    table.cell(t,1,7,absorption)
    table.cell(t,0,8,"Delta Proxy")
    table.cell(t,1,8,str.tostring(deltaProxy))
    table.cell(t,0,9,"CVD Bias")
    table.cell(t,1,9,cvdBias)
    table.cell(t,0,10,"Trade State")
    table.cell(t,1,10,tradeState)

plot(highRange,"Balance High")
plot(lowRange,"Balance Low")
