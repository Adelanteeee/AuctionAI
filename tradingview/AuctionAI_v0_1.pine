//@version=6
indicator("AuctionAI v0.1 - Decision Support System", overlay=true)

//==================================================
// AuctionAI Sprint 1.1
// Context Engine Foundation
// Context > Evidence
//==================================================

showPanel = input.bool(true, "Show AuctionAI Panel")
lookback = input.int(50, "Context Lookback")

//-------------------------
// Context Engine
//-------------------------
highRange = ta.highest(high, lookback)
lowRange  = ta.lowest(low, lookback)
rangeSize = highRange - lowRange

positionInRange = rangeSize != 0 ? (close - lowRange) / rangeSize : 0.5

string location = "MID VALUE"
if positionInRange > 0.75
    location := "UPPER VALUE"
else if positionInRange < 0.25
    location := "LOWER VALUE"

atr = ta.atr(14)
expansion = math.abs(close - close[10]) > atr * 2

string marketContext = "BALANCE"
if expansion
    marketContext := close > close[10] ? "BULL EXPANSION" : "BEAR EXPANSION"

string auctionState = "SEARCHING"
if expansion
    auctionState := "TESTING NEW VALUE"
else
    auctionState := "BALANCE AUCTION"

//-------------------------
// Evidence placeholders
//-------------------------
// Future engines:
// Delta
// CVD
// Effort vs Result
// Initiative / Responsive

contextScore = 0
if marketContext == "BULL EXPANSION"
    contextScore := 3
else if marketContext == "BEAR EXPANSION"
    contextScore := -3

confidence = contextScore * 0.40
confidence10 = math.round(((confidence + 10) / 2) * 10) / 10

//-------------------------
// Panel
//-------------------------
var table panel = table.new(position.top_right, 2, 9, border_width=1)

if barstate.islast and showPanel
    table.cell(panel,0,0,"AuctionAI v0.1")
    table.cell(panel,1,0,"ACTIVE")

    table.cell(panel,0,1,"Context")
    table.cell(panel,1,1,marketContext)

    table.cell(panel,0,2,"Location")
    table.cell(panel,1,2,location)

    table.cell(panel,0,3,"Auction")
    table.cell(panel,1,3,auctionState)

    table.cell(panel,0,4,"Context Score")
    table.cell(panel,1,4,str.tostring(contextScore))

    table.cell(panel,0,5,"Delta")
    table.cell(panel,1,5,"Pending")

    table.cell(panel,0,6,"CVD")
    table.cell(panel,1,6,"Pending")

    table.cell(panel,0,7,"Effort/Initiative")
    table.cell(panel,1,7,"Pending")

    table.cell(panel,0,8,"Confidence")
    table.cell(panel,1,8,str.tostring(confidence10)+"/10")

plot(na)
