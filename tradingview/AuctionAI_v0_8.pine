//@version=6
indicator("AuctionAI v0.8 - Decision Quality & Invalidation Intelligence", overlay=true)

// v0.8 — Decision Quality & Invalidation Intelligence
// Extends v0.7 with decision evolution, health, evidence persistence,
// conflict persistence, invalidation candidate/recovery, decision memory,
// decision snapshot and decision drift.
// No entry, SL, TP, sizing, execution, prediction, ML or auto-trading.
// Acceptance Score remains Evidence Quality Only.

// ---------- INPUTS ----------
lookback = input.int(50, "Balance Lookback", minval=5)
atrLength = input.int(14, "ATR Length", minval=1)
volumeLength = input.int(20, "Volume Average Length", minval=2)
deltaFastLen = input.int(20, "Delta Fast Length", minval=2)
deltaSlowLen = input.int(50, "Delta Slow Length", minval=3)
strongBodyATR = input.float(0.7, "Strong Body / ATR", minval=0.1, step=0.1)
resultATR = input.float(0.5, "High Result / ATR", minval=0.1, step=0.1)
acceptBarsRequired = input.int(2, "Acceptance Confirmation Bars", minval=1, maxval=5)
retestDeltaMin = input.float(5.0, "Retest Delta Alignment Threshold", minval=0.0, step=1.0)
retestResultATR = input.float(0.25, "Retest Result / ATR", minval=0.05, step=0.05)
retestWindowBars = input.int(20, "Retest Window Bars", minval=1, maxval=100)
reclaimBarsRequired = input.int(1, "Reclaim Confirmation Bars", minval=1, maxval=3)
failureBarsRequired = input.int(2, "Breach Failure Confirmation Bars", minval=1, maxval=5)
conflictThreshold = input.int(2, "Decision Conflict Threshold", minval=0, maxval=5)
biasConfirmBars = input.int(2, "Bias Confirmation Bars", minval=1, maxval=5)
biasInvalidateBars = input.int(2, "Bias Invalidation Bars", minval=1, maxval=5)
conflictPersistenceBars = input.int(3, "Conflict Persistence Bars", minval=1, maxval=10)
invalidationCandidateBars = input.int(2, "Invalidation Candidate Bars", minval=1, maxval=10)
recoveryConfirmBars = input.int(2, "Recovery Confirmation Bars", minval=1, maxval=10)
showPanel = input.bool(true, "Show Panel")
showDiagnostics = input.bool(false, "Show Diagnostics")
showBalance = input.bool(true, "Show Balance")
showAcceptedLevel = input.bool(true, "Show Accepted Level")
showSignals = input.bool(true, "Show Event Signals")
panelTextSize = input.string("Small", "Panel Text Size", options=["Tiny", "Small", "Normal"])
textSize = panelTextSize == "Tiny" ? size.tiny : panelTextSize == "Normal" ? size.normal : size.small

// ---------- MARKET EVIDENCE ----------
rangeHigh = ta.highest(high, lookback)[1]
rangeLow = ta.lowest(low, lookback)[1]
rangeSize = rangeHigh - rangeLow
positionValue = rangeSize > 0 ? (close - rangeLow) / rangeSize : 0.5
locationText = positionValue > 0.75 ? "UPPER VALUE" : positionValue < 0.25 ? "LOWER VALUE" : "MID VALUE"
context = positionValue > 0.75 ? "UPPER" : positionValue < 0.25 ? "LOWER" : "BALANCE"
atr = ta.atr(atrLength)
body = math.abs(close - open)
strongBody = body > atr * strongBodyATR
breakoutUp = close > rangeHigh
breakoutDown = close < rangeLow
volumeAvg = ta.sma(volume, volumeLength)
effortHigh = volume > volumeAvg
resultMagnitude = math.abs(close - close[1])
resultHigh = resultMagnitude > atr * resultATR
retestResultHigh = resultMagnitude > atr * retestResultATR
aRange = math.max(high - low, syminfo.mintick)
buyPressure = ((close - low) / aRange) * 100.0
sellPressure = ((high - close) / aRange) * 100.0
deltaProxy = buyPressure - sellPressure
deltaFast = ta.ema(deltaProxy, deltaFastLen)
deltaSlow = ta.ema(deltaProxy, deltaSlowLen)
cvdProxy = ta.cum(deltaProxy)
cvdUp = deltaFast > deltaSlow
cvdDown = deltaFast < deltaSlow
deltaUp = deltaProxy > 0
deltaDown = deltaProxy < 0
possibleAbsorption = effortHigh and not resultHigh

// ---------- ACCEPTANCE ----------
barScoreUp = (breakoutUp ? 2 : 0) + (breakoutUp and strongBody ? 1 : 0) + (breakoutUp and resultHigh ? 1 : 0) + (breakoutUp and deltaUp ? 2 : 0) + (breakoutUp and cvdUp ? 2 : 0) + (breakoutUp and effortHigh ? 1 : 0) - (breakoutUp and possibleAbsorption ? 3 : 0)
barScoreDown = (breakoutDown ? 2 : 0) + (breakoutDown and strongBody ? 1 : 0) + (breakoutDown and resultHigh ? 1 : 0) + (breakoutDown and deltaDown ? 2 : 0) + (breakoutDown and cvdDown ? 2 : 0) + (breakoutDown and effortHigh ? 1 : 0) - (breakoutDown and possibleAbsorption ? 3 : 0)
var int upAcceptanceBars = 0
var int downAcceptanceBars = 0
var float upScore = 0.0
var float downScore = 0.0
upAcceptanceBars := breakoutUp ? upAcceptanceBars + 1 : 0
downAcceptanceBars := breakoutDown ? downAcceptanceBars + 1 : 0
upScore := breakoutUp ? upScore + math.max(0, barScoreUp) : 0
downScore := breakoutDown ? downScore + math.max(0, barScoreDown) : 0
confirmedUp = upAcceptanceBars >= acceptBarsRequired
confirmedDown = downAcceptanceBars >= acceptBarsRequired
newAcceptUp = confirmedUp and not confirmedUp[1]
newAcceptDown = confirmedDown and not confirmedDown[1]
acceptanceScore = confirmedUp ? math.min(10.0, upScore) : confirmedDown ? math.min(10.0, downScore) : math.min(10.0, math.max(upScore, downScore))

// ---------- LIFECYCLE ----------
const int NONE = 0
const int WAIT_RETEST = 1
const int RETEST_WEAK = 2
const int RETEST_HOLD = 3
const int BREACH_WARNING = 4
const int RECLAIM_CONFIRMED = 5
const int RETEST_FAIL = 6
const int RETEST_EXPIRED = 7

var int state = NONE
var int direction = 0
var float acceptedLevel = na
var int acceptanceIndex = na
var int stateIndex = na
var int breachCount = 0
var int reclaimCount = 0
var int setupId = 0
var bool setupActive = false

// ---------- SNAPSHOTS ----------
var float acceptanceDeltaSnap = na
var int acceptanceCvdSnap = 0
var float acceptanceResultSnap = na
var float acceptanceEffortSnap = na
var bool acceptanceAbsorptionSnap = false
var float acceptanceScoreSnap = na
var int acceptanceSnapshotBar = na
var float retestDeltaSnap = na
var int retestCvdSnap = 0
var float retestResultSnap = na
var float retestEffortSnap = na
var bool retestAbsorptionSnap = false
var float retestScoreSnap = na
var int retestSnapshotBar = na

var int archivedSetupId = 0
var int archivedFinalState = NONE

if newAcceptUp or newAcceptDown
    if setupActive
        archivedSetupId := setupId
        archivedFinalState := state
    setupId += 1
    direction := newAcceptUp ? 1 : -1
    acceptedLevel := newAcceptUp ? rangeHigh : rangeLow
    acceptanceIndex := bar_index
    stateIndex := bar_index
    state := WAIT_RETEST
    setupActive := true
    breachCount := 0
    reclaimCount := 0
    acceptanceDeltaSnap := deltaProxy
    acceptanceCvdSnap := cvdUp ? 1 : cvdDown ? -1 : 0
    acceptanceResultSnap := resultMagnitude / math.max(atr, syminfo.mintick)
    acceptanceEffortSnap := volume / math.max(volumeAvg, 1.0)
    acceptanceAbsorptionSnap := possibleAbsorption
    acceptanceScoreSnap := math.min(10.0, acceptanceScore)
    acceptanceSnapshotBar := bar_index
    retestDeltaSnap := na
    retestCvdSnap := 0
    retestResultSnap := na
    retestEffortSnap := na
    retestAbsorptionSnap := false
    retestScoreSnap := na
    retestSnapshotBar := na

hasSetup = setupActive and not na(acceptedLevel) and not na(acceptanceIndex)
barsSinceAcceptance = hasSetup ? bar_index - acceptanceIndex : 0
stateAge = hasSetup and not na(stateIndex) ? bar_index - stateIndex : 0

// ---------- RETEST ----------
waitLike = hasSetup and (state == WAIT_RETEST or state == RETEST_WEAK)
retestTouchUp = waitLike and direction == 1 and low <= acceptedLevel and close >= acceptedLevel
retestTouchDown = waitLike and direction == -1 and high >= acceptedLevel and close <= acceptedLevel
retestDeltaUp = deltaProxy >= retestDeltaMin
retestDeltaDown = deltaProxy <= -retestDeltaMin
retestReactionUp = close > open and close >= close[1]
retestReactionDown = close < open and close <= close[1]
retestHighEffortLowResult = effortHigh and not retestResultHigh
retestHoldUp = retestTouchUp and retestReactionUp and retestResultHigh and retestDeltaUp and cvdUp and not retestHighEffortLowResult and not possibleAbsorption
retestHoldDown = retestTouchDown and retestReactionDown and retestResultHigh and retestDeltaDown and cvdDown and not retestHighEffortLowResult and not possibleAbsorption
retestTouched = retestTouchUp or retestTouchDown
retestWeakNow = retestTouched and not (retestHoldUp or retestHoldDown)

if retestTouched and na(retestSnapshotBar)
    retestDeltaSnap := deltaProxy
    retestCvdSnap := cvdUp ? 1 : cvdDown ? -1 : 0
    retestResultSnap := resultMagnitude / math.max(atr, syminfo.mintick)
    retestEffortSnap := volume / math.max(volumeAvg, 1.0)
    retestAbsorptionSnap := possibleAbsorption
    retestScoreSnap := math.min(10.0, math.max(0.0, (direction == 1 and retestDeltaUp or direction == -1 and retestDeltaDown ? 2 : 0) + (direction == 1 and cvdUp or direction == -1 and cvdDown ? 2 : 0) + (retestResultHigh ? 2 : 0) + (effortHigh and retestResultHigh ? 1 : 0) + (not possibleAbsorption ? 1 : 0)))
    retestSnapshotBar := bar_index

if hasSetup and waitLike and barsSinceAcceptance >= retestWindowBars and not retestTouched
    archivedSetupId := setupId
    archivedFinalState := RETEST_EXPIRED
    setupActive := false
    state := RETEST_EXPIRED
    stateIndex := bar_index
    breachCount := 0
    reclaimCount := 0

if hasSetup and waitLike and (retestHoldUp or retestHoldDown)
    state := RETEST_HOLD
    stateIndex := bar_index
    breachCount := 0
    reclaimCount := 0
else if hasSetup and waitLike and retestWeakNow
    if state != RETEST_WEAK
        stateIndex := bar_index
    state := RETEST_WEAK

// ---------- BREACH / RECLAIM ----------
breachUp = hasSetup and (state == WAIT_RETEST or state == RETEST_WEAK or state == RETEST_HOLD or state == RECLAIM_CONFIRMED) and direction == 1 and close < acceptedLevel
breachDown = hasSetup and (state == WAIT_RETEST or state == RETEST_WEAK or state == RETEST_HOLD or state == RECLAIM_CONFIRMED) and direction == -1 and close > acceptedLevel
reclaimCandidate = hasSetup and state == BREACH_WARNING and ((direction == 1 and close >= acceptedLevel) or (direction == -1 and close <= acceptedLevel))

if breachUp or breachDown
    breachCount := state == BREACH_WARNING ? breachCount + 1 : 1
    reclaimCount := 0
    if state != BREACH_WARNING
        state := BREACH_WARNING
        stateIndex := bar_index

if hasSetup and state == BREACH_WARNING and reclaimCandidate
    reclaimCount += 1
    breachCount := 0
    if reclaimCount >= reclaimBarsRequired
        state := RECLAIM_CONFIRMED
        stateIndex := bar_index
        reclaimCount := 0

if hasSetup and state == BREACH_WARNING and breachCount >= failureBarsRequired
    archivedSetupId := setupId
    archivedFinalState := RETEST_FAIL
    setupActive := false
    state := RETEST_FAIL
    stateIndex := bar_index
    breachCount := 0
    reclaimCount := 0

// ---------- EVIDENCE COMPARISON ----------
retestScoreAvailable = not na(retestScoreSnap)
scoreChange = retestScoreAvailable and not na(acceptanceScoreSnap) ? retestScoreSnap - acceptanceScoreSnap : na
evidenceTrend = not retestScoreAvailable ? "PENDING" : scoreChange >= 1 ? "STRENGTHENING" : scoreChange <= -1 ? "WEAKENING" : "STABLE"
acceptDeltaDir = na(acceptanceDeltaSnap) ? 0 : acceptanceDeltaSnap > 0 ? 1 : acceptanceDeltaSnap < 0 ? -1 : 0
retestDeltaDir = na(retestDeltaSnap) ? 0 : retestDeltaSnap > 0 ? 1 : retestDeltaSnap < 0 ? -1 : 0
flowConflict = retestScoreAvailable and ((direction == 1 and retestDeltaDir == 1 and retestCvdSnap == -1) or (direction == -1 and retestDeltaDir == -1 and retestCvdSnap == 1))
deltaComparisonConflict = retestScoreAvailable and acceptDeltaDir != 0 and retestDeltaDir != 0 and acceptDeltaDir != retestDeltaDir
cvdComparisonConflict = retestScoreAvailable and acceptanceCvdSnap != 0 and retestCvdSnap != 0 and acceptanceCvdSnap != retestCvdSnap
absorptionConflict = retestScoreAvailable and retestAbsorptionSnap
resultConflict = retestScoreAvailable and not na(acceptanceResultSnap) and not na(retestResultSnap) and retestResultSnap < acceptanceResultSnap * 0.75
conflictCount = (flowConflict ? 1 : 0) + (deltaComparisonConflict ? 1 : 0) + (cvdComparisonConflict ? 1 : 0) + (absorptionConflict ? 1 : 0) + (resultConflict ? 1 : 0)
conflictText = conflictCount == 0 ? "NONE" : (flowConflict ? "FLOW; " : "") + (deltaComparisonConflict ? "DELTA; " : "") + (cvdComparisonConflict ? "CVD; " : "") + (absorptionConflict ? "ABSORPTION; " : "") + (resultConflict ? "RESULT; " : "")

// ---------- CONFLUENCE / QUALITY ----------
activeStructure = hasSetup and (state == WAIT_RETEST or state == RETEST_WEAK or state == RETEST_HOLD or state == BREACH_WARNING or state == RECLAIM_CONFIRMED)
priceAligned = activeStructure and (direction == 1 ? close >= acceptedLevel : close <= acceptedLevel)
deltaAligned = activeStructure and (direction == 1 ? deltaUp : deltaDown)
cvdAligned = activeStructure and (direction == 1 ? cvdUp : cvdDown)
resultAligned = activeStructure and (direction == 1 ? close >= close[1] and resultHigh : close <= close[1] and resultHigh)
noAbsorption = activeStructure and not possibleAbsorption
retestAligned = state == RETEST_HOLD and retestScoreAvailable and conflictCount == 0
confluenceScore = (priceAligned ? 2 : 0) + (deltaAligned ? 2 : 0) + (cvdAligned ? 2 : 0) + (resultAligned ? 1 : 0) + (noAbsorption ? 1 : 0) + (retestAligned ? 2 : 0)
confluenceScoreClamped = math.max(0, math.min(10, confluenceScore))
acceptQualityStrong = not na(acceptanceScoreSnap) and acceptanceScoreSnap >= 6
retestQualityStrong = retestScoreAvailable and retestScoreSnap >= 6

// ---------- v0.7 DECISION ENGINE ----------
const int DEC_WAIT = 0
const int DEC_LONG = 1
const int DEC_SHORT = -1
const int DEC_INVALID = 2
const int DEC_CONFLICT = 3

var int decisionState = DEC_WAIT
var int candidateDirection = 0
var int candidateBars = 0
var int oppositeBars = 0
var int decisionAge = 0
var int decisionSetupId = 0

acceptanceGateLong = hasSetup and direction == 1 and state != RETEST_FAIL and state != RETEST_EXPIRED and not na(acceptanceScoreSnap)
acceptanceGateShort = hasSetup and direction == -1 and state != RETEST_FAIL and state != RETEST_EXPIRED and not na(acceptanceScoreSnap)
retestGateLong = hasSetup and direction == 1 and (state == RETEST_HOLD or state == RECLAIM_CONFIRMED)
retestGateShort = hasSetup and direction == -1 and (state == RETEST_HOLD or state == RECLAIM_CONFIRMED)
evidenceGateLong = direction == 1 and (not retestScoreAvailable or retestQualityStrong or state == RECLAIM_CONFIRMED)
evidenceGateShort = direction == -1 and (not retestScoreAvailable or retestQualityStrong or state == RECLAIM_CONFIRMED)
conflictGate = conflictThreshold == 0 ? conflictCount == 0 : conflictCount < conflictThreshold
contextGateLong = direction == 1 and context != "LOWER"
contextGateShort = direction == -1 and context != "UPPER"
contextGate = direction == 1 ? contextGateLong : direction == -1 ? contextGateShort : false
candidateLong = acceptanceGateLong and retestGateLong and evidenceGateLong and conflictGate and contextGate
candidateShort = acceptanceGateShort and retestGateShort and evidenceGateShort and conflictGate and contextGate

if candidateLong
    candidateDirection := 1
    candidateBars := candidateDirection[1] == 1 ? candidateBars[1] + 1 : 1
else if candidateShort
    candidateDirection := -1
    candidateBars := candidateDirection[1] == -1 ? candidateBars[1] + 1 : 1
else
    candidateDirection := 0
    candidateBars := 0

oppositePressureLong = hasSetup and direction == -1 and (state == RETEST_FAIL or state == RETEST_EXPIRED or conflictCount >= conflictThreshold)
oppositePressureShort = hasSetup and direction == 1 and (state == RETEST_FAIL or state == RETEST_EXPIRED or conflictCount >= conflictThreshold)
oppositeBars := (decisionState == DEC_LONG and oppositePressureShort) or (decisionState == DEC_SHORT and oppositePressureLong) ? oppositeBars + 1 : 0
longConfirmed = candidateLong and candidateBars >= biasConfirmBars
shortConfirmed = candidateShort and candidateBars >= biasConfirmBars

if decisionState == DEC_LONG
    if oppositeBars >= biasInvalidateBars or not hasSetup
        decisionState := DEC_INVALID
        decisionAge := 0
else if decisionState == DEC_SHORT
    if oppositeBars >= biasInvalidateBars or not hasSetup
        decisionState := DEC_INVALID
        decisionAge := 0
else if longConfirmed
    decisionState := DEC_LONG
    decisionSetupId := setupId
    decisionAge := 0
else if shortConfirmed
    decisionState := DEC_SHORT
    decisionSetupId := setupId
    decisionAge := 0
else if hasSetup and state == RETEST_HOLD and conflictCount >= conflictThreshold
    decisionState := DEC_CONFLICT
    decisionAge := 0
else
    if decisionState == DEC_INVALID or decisionState == DEC_CONFLICT
        decisionState := DEC_WAIT
    decisionAge += 1

if decisionState == DEC_LONG and direction == 1 and (state == RETEST_FAIL or state == RETEST_EXPIRED)
    decisionState := DEC_INVALID
if decisionState == DEC_SHORT and direction == -1 and (state == RETEST_FAIL or state == RETEST_EXPIRED)
    decisionState := DEC_INVALID

// ---------- v0.8 DECISION INTELLIGENCE ----------
// Evidence persistence: current evidence must remain aligned/conflicted across bars.
var int deltaAlignedBars = 0
var int cvdAlignedBars = 0
var int resultAlignedBars = 0
var int absorptionBars = 0
var int conflictBars = 0

deltaAlignedBars := activeStructure and deltaAligned ? deltaAlignedBars + 1 : 0
cvdAlignedBars := activeStructure and cvdAligned ? cvdAlignedBars + 1 : 0
resultAlignedBars := activeStructure and resultAligned ? resultAlignedBars + 1 : 0
absorptionBars := activeStructure and possibleAbsorption ? absorptionBars + 1 : 0
conflictBars := activeStructure and conflictCount >= conflictThreshold and conflictThreshold > 0 ? conflictBars + 1 : 0

persistentConflict = conflictBars >= conflictPersistenceBars
persistentOpposite = (decisionState == DEC_LONG and direction == 1 and not deltaAligned and not cvdAligned) or (decisionState == DEC_SHORT and direction == -1 and not deltaAligned and not cvdAligned)

// Invalidation candidate: deterioration must persist before invalidation.
var int invalidationCandidateCount = 0
invalidationPressure = decisionState == DEC_LONG ? (direction != 1 or state == RETEST_FAIL or state == RETEST_EXPIRED or persistentConflict or persistentOpposite or context == "LOWER") : decisionState == DEC_SHORT ? (direction != -1 or state == RETEST_FAIL or state == RETEST_EXPIRED or persistentConflict or persistentOpposite or context == "UPPER") : false
invalidationCandidate = (decisionState == DEC_LONG or decisionState == DEC_SHORT) and invalidationPressure and state != RETEST_FAIL and state != RETEST_EXPIRED

if invalidationCandidate
    invalidationCandidateCount += 1
else
    invalidationCandidateCount := 0

invalidationCandidateConfirmed = invalidationCandidateCount >= invalidationCandidateBars

// Recovery: a deteriorating decision can recover without passing through INVALIDATED.
var int recoveryBars = 0
recoveryEvidence = (decisionState == DEC_LONG and direction == 1 and deltaAligned and cvdAligned and conflictCount == 0 and state == RETEST_HOLD) or (decisionState == DEC_SHORT and direction == -1 and deltaAligned and cvdAligned and conflictCount == 0 and state == RETEST_HOLD)
if recoveryEvidence
    recoveryBars += 1
else
    recoveryBars := 0
recoveryConfirmed = recoveryBars >= recoveryConfirmBars

// Decision trend compares current evidence with the decision snapshot baseline.
var float decisionSnapshotScore = na
var int decisionSnapshotBar = na
var int decisionSnapshotSetupId = 0
var int decisionSnapshotDirection = 0
var string decisionSnapshotHealth = "NONE"
var string decisionSnapshotConfidence = "LOW"

currentDecisionEvidenceScore = math.max(0.0, math.min(10.0, confluenceScoreClamped + (retestScoreAvailable ? retestScoreSnap * 0.25 : 0.0)))

// Snapshot is captured once when a new directional decision is established.
newLongDecision = decisionState == DEC_LONG and decisionState[1] != DEC_LONG
newShortDecision = decisionState == DEC_SHORT and decisionState[1] != DEC_SHORT
if newLongDecision or newShortDecision
    decisionSnapshotScore := currentDecisionEvidenceScore
    decisionSnapshotBar := bar_index
    decisionSnapshotSetupId := setupId
    decisionSnapshotDirection := decisionState == DEC_LONG ? 1 : -1
    decisionSnapshotHealth := "HEALTHY"
    decisionSnapshotConfidence := "LOW"

snapshotScoreChange = not na(decisionSnapshotScore) ? currentDecisionEvidenceScore - decisionSnapshotScore : na
decisionTrend = not (decisionState == DEC_LONG or decisionState == DEC_SHORT) ? "NONE" : na(snapshotScoreChange) ? "STABLE" : snapshotScoreChange >= 1.0 ? "STRENGTHENING" : snapshotScoreChange <= -1.0 ? "WEAKENING" : "STABLE"

// Health is qualitative and deliberately not a raw score.
decisionHealth = decisionState == DEC_INVALID ? "INVALID" : decisionState == DEC_CONFLICT ? "DETERIORATING" : invalidationCandidateConfirmed ? "DETERIORATING" : recoveryConfirmed ? "HEALTHY" : decisionState == DEC_LONG or decisionState == DEC_SHORT ? (persistentConflict or decisionTrend == "WEAKENING" ? "CAUTION" : "HEALTHY") : "CAUTION"

// Decision quality remains separate from confidence.
decisionQuality = decisionState == DEC_LONG or decisionState == DEC_SHORT ? (acceptQualityStrong and retestQualityStrong and conflictCount == 0 ? "HIGH" : acceptQualityStrong or retestQualityStrong ? "MEDIUM" : "LOW") : decisionState == DEC_CONFLICT ? "LOW" : activeStructure ? "MEDIUM" : "LOW"
decisionConfidence = not hasSetup ? "LOW" : decisionState == DEC_LONG or decisionState == DEC_SHORT ? (decisionHealth == "HEALTHY" and decisionTrend != "WEAKENING" and conflictCount == 0 and confluenceScoreClamped >= 7 ? "HIGH" : confluenceScoreClamped >= 4 and conflictBars < conflictPersistenceBars ? "MEDIUM" : "LOW") : decisionState == DEC_CONFLICT ? "LOW" : state == RETEST_HOLD and conflictCount == 0 ? "MEDIUM" : "LOW"

// Decision drift is measured against the immutable decision snapshot.
decisionDrift = decisionState != DEC_LONG and decisionState != DEC_SHORT ? "NONE" : na(snapshotScoreChange) ? "NONE" : snapshotScoreChange >= 1.0 ? "POSITIVE" : snapshotScoreChange <= -1.0 ? "NEGATIVE" : "STABLE"

// Update the stored snapshot labels only for descriptive memory; baseline score never changes.
if newLongDecision or newShortDecision
    decisionSnapshotHealth := decisionHealth
    decisionSnapshotConfidence := decisionConfidence

// ---------- REASONS / INVALIDATION ----------
decisionText = decisionState == DEC_LONG ? "LONG BIAS" : decisionState == DEC_SHORT ? "SHORT BIAS" : decisionState == DEC_INVALID ? "INVALIDATED" : decisionState == DEC_CONFLICT ? "CONFLICT" : "WAIT"
decisionDirectionText = direction == 1 ? "LONG" : direction == -1 ? "SHORT" : "NONE"
healthText = decisionHealth
reason = decisionState == DEC_LONG ? (recoveryConfirmed ? "Decision recovered; evidence realigned" : invalidationCandidateConfirmed ? "Decision deteriorating; invalidation candidate confirmed" : "Acceptance + Retest gates passed; evidence supports LONG") : decisionState == DEC_SHORT ? (recoveryConfirmed ? "Decision recovered; evidence realigned" : invalidationCandidateConfirmed ? "Decision deteriorating; invalidation candidate confirmed" : "Acceptance + Retest gates passed; evidence supports SHORT") : decisionState == DEC_CONFLICT ? "Bias blocked by persistent evidence conflict" : decisionState == DEC_INVALID ? (state == RETEST_FAIL ? "Retest failure invalidated the structure" : state == RETEST_EXPIRED ? "Retest window expired" : persistentConflict ? "Persistent evidence conflict" : "Decision invalidated") : state == WAIT_RETEST ? "Acceptance confirmed; waiting for retest" : state == RETEST_WEAK ? "Retest weak; decision not confirmed" : state == BREACH_WARNING ? "Accepted level breached; reclaim/failure pending" : state == RECLAIM_CONFIRMED ? "Reclaim confirmed; waiting for stable decision" : "Insufficient evidence for directional bias"
invalidationReason = state == RETEST_FAIL ? "Retest failure" : state == RETEST_EXPIRED ? "Retest window expired" : persistentConflict ? "Persistent evidence conflict" : context == "LOWER" and decisionState == DEC_LONG ? "Context gate failed" : context == "UPPER" and decisionState == DEC_SHORT ? "Context gate failed" : direction == 1 ? "Persistent breach / conflict / context invalidation" : direction == -1 ? "Persistent breach / conflict / context invalidation" : "New opposing setup"

// ---------- COMPACT HUD ----------
var table panel = table.new(position.top_right, 2, 34, border_width=1)
if barstate.islast and showPanel
    table.clear(panel, 0, 0, 1, 33)
    table.cell(panel, 0, 0, "AuctionAI v0.8", text_size=textSize)
    table.cell(panel, 1, 0, "DECISION INTELLIGENCE", text_size=textSize)
    table.cell(panel, 0, 1, "Setup", text_size=textSize)
    table.cell(panel, 1, 1, setupActive ? "#" + str.tostring(setupId) : "ARCHIVED #" + str.tostring(archivedSetupId), text_size=textSize)
    table.cell(panel, 0, 2, "Context", text_size=textSize)
    table.cell(panel, 1, 2, context, text_size=textSize)
    table.cell(panel, 0, 3, "Lifecycle", text_size=textSize)
    table.cell(panel, 1, 3, state == WAIT_RETEST ? "WAIT RETEST" : state == RETEST_WEAK ? "RETEST WEAK" : state == RETEST_HOLD ? "RETEST HOLD" : state == BREACH_WARNING ? "BREACH WARNING" : state == RECLAIM_CONFIRMED ? "RECLAIM CONFIRMED" : state == RETEST_FAIL ? "RETEST FAIL" : state == RETEST_EXPIRED ? "RETEST EXPIRED" : "NONE", text_size=textSize)
    table.cell(panel, 0, 4, "Acceptance", text_size=textSize)
    table.cell(panel, 1, 4, setupActive ? (direction == 1 ? "CONFIRMED UP" : "CONFIRMED DOWN") : "NONE", text_size=textSize)
    table.cell(panel, 0, 5, "Accept Score", text_size=textSize)
    table.cell(panel, 1, 5, na(acceptanceScoreSnap) ? "—" : str.tostring(acceptanceScoreSnap, "#.0") + " / 10", text_size=textSize)
    table.cell(panel, 0, 6, "Retest", text_size=textSize)
    table.cell(panel, 1, 6, retestScoreAvailable ? (state == RETEST_HOLD ? "HOLD" : state == RETEST_WEAK ? "WEAK" : "SNAPSHOT") : "PENDING", text_size=textSize)
    table.cell(panel, 0, 7, "Evidence", text_size=textSize)
    table.cell(panel, 1, 7, evidenceTrend, text_size=textSize)
    table.cell(panel, 0, 8, "Conflict", text_size=textSize)
    table.cell(panel, 1, 8, str.tostring(conflictCount) + (persistentConflict ? " / PERSISTENT" : ""), text_size=textSize)
    table.cell(panel, 0, 9, "Confluence", text_size=textSize)
    table.cell(panel, 1, 9, str.tostring(confluenceScoreClamped) + " / 10", text_size=textSize)
    table.cell(panel, 0, 10, "Decision", text_size=textSize)
    table.cell(panel, 1, 10, decisionText, text_size=textSize)
    table.cell(panel, 0, 11, "Direction", text_size=textSize)
    table.cell(panel, 1, 11, decisionDirectionText, text_size=textSize)
    table.cell(panel, 0, 12, "Quality", text_size=textSize)
    table.cell(panel, 1, 12, decisionQuality, text_size=textSize)
    table.cell(panel, 0, 13, "Confidence", text_size=textSize)
    table.cell(panel, 1, 13, decisionConfidence, text_size=textSize)
    table.cell(panel, 0, 14, "Health", text_size=textSize)
    table.cell(panel, 1, 14, healthText, text_size=textSize)
    table.cell(panel, 0, 15, "Trend", text_size=textSize)
    table.cell(panel, 1, 15, decisionTrend, text_size=textSize)
    table.cell(panel, 0, 16, "Drift", text_size=textSize)
    table.cell(panel, 1, 16, decisionDrift, text_size=textSize)
    table.cell(panel, 0, 17, "Decision Age", text_size=textSize)
    table.cell(panel, 1, 17, str.tostring(decisionAge) + " bars", text_size=textSize)
    table.cell(panel, 0, 18, "Reason", text_size=textSize)
    table.cell(panel, 1, 18, reason, text_size=textSize)
    table.cell(panel, 0, 19, "Invalidation", text_size=textSize)
    table.cell(panel, 1, 19, invalidationReason, text_size=textSize)
    if showDiagnostics
        table.cell(panel, 0, 20, "GATES", text_size=textSize)
        table.cell(panel, 1, 20, "A / R / E / C / X", text_size=textSize)
        table.cell(panel, 0, 21, "Acceptance Gate", text_size=textSize)
        table.cell(panel, 1, 21, (acceptanceGateLong or acceptanceGateShort) ? "PASS" : "FAIL", text_size=textSize)
        table.cell(panel, 0, 22, "Retest Gate", text_size=textSize)
        table.cell(panel, 1, 22, (retestGateLong or retestGateShort) ? "PASS" : "FAIL", text_size=textSize)
        table.cell(panel, 0, 23, "Evidence Gate", text_size=textSize)
        table.cell(panel, 1, 23, (evidenceGateLong or evidenceGateShort) ? "PASS" : "FAIL", text_size=textSize)
        table.cell(panel, 0, 24, "Conflict Gate", text_size=textSize)
        table.cell(panel, 1, 24, conflictGate ? "PASS" : "FAIL", text_size=textSize)
        table.cell(panel, 0, 25, "Context Gate", text_size=textSize)
        table.cell(panel, 1, 25, contextGate ? "PASS" : "FAIL", text_size=textSize)
        table.cell(panel, 0, 26, "Candidate", text_size=textSize)
        table.cell(panel, 1, 26, candidateDirection == 1 ? "LONG" : candidateDirection == -1 ? "SHORT" : "NONE", text_size=textSize)
        table.cell(panel, 0, 27, "Candidate Age", text_size=textSize)
        table.cell(panel, 1, 27, str.tostring(candidateBars) + " / " + str.tostring(biasConfirmBars), text_size=textSize)
        table.cell(panel, 0, 28, "Conflict Age", text_size=textSize)
        table.cell(panel, 1, 28, str.tostring(conflictBars) + " / " + str.tostring(conflictPersistenceBars), text_size=textSize)
        table.cell(panel, 0, 29, "Delta Persistence", text_size=textSize)
        table.cell(panel, 1, 29, str.tostring(deltaAlignedBars) + " bars", text_size=textSize)
        table.cell(panel, 0, 30, "CVD Persistence", text_size=textSize)
        table.cell(panel, 1, 30, str.tostring(cvdAlignedBars) + " bars", text_size=textSize)
        table.cell(panel, 0, 31, "Invalid Candidate", text_size=textSize)
        table.cell(panel, 1, 31, str.tostring(invalidationCandidateCount) + " / " + str.tostring(invalidationCandidateBars), text_size=textSize)
        table.cell(panel, 0, 32, "Recovery", text_size=textSize)
        table.cell(panel, 1, 32, str.tostring(recoveryBars) + " / " + str.tostring(recoveryConfirmBars), text_size=textSize)
        table.cell(panel, 0, 33, "Snapshot", text_size=textSize)
        table.cell(panel, 1, 33, na(decisionSnapshotBar) ? "NONE" : "SETUP #" + str.tostring(decisionSnapshotSetupId) + " / BAR " + str.tostring(decisionSnapshotBar), text_size=textSize)

// ---------- PRICE-SCALE-SAFE VISUALS ----------
plot(showBalance ? rangeHigh : na, "Balance High")
plot(showBalance ? rangeLow : na, "Balance Low")
plot(showAcceptedLevel and activeStructure ? acceptedLevel : na, "Accepted Level")
plotshape(showSignals and newAcceptUp, title="Acceptance Up", style=shape.triangleup, location=location.belowbar, size=size.tiny, text="A↑")
plotshape(showSignals and newAcceptDown, title="Acceptance Down", style=shape.triangledown, location=location.abovebar, size=size.tiny, text="A↓")
plotshape(showSignals and state == RETEST_HOLD and state[1] != RETEST_HOLD, title="Retest Hold", style=shape.circle, location=location.belowbar, size=size.tiny, text="H")
plotshape(showSignals and state == RETEST_WEAK and state[1] != RETEST_WEAK, title="Retest Weak", style=shape.diamond, location=location.abovebar, size=size.tiny, text="W")
plotshape(showSignals and state == BREACH_WARNING and state[1] != BREACH_WARNING, title="Breach Warning", style=shape.xcross, location=location.abovebar, size=size.tiny, text="B")
plotshape(showSignals and state == RECLAIM_CONFIRMED and state[1] != RECLAIM_CONFIRMED, title="Reclaim Confirmed", style=shape.circle, location=location.belowbar, size=size.tiny, text="RC")
plotshape(showSignals and state == RETEST_FAIL and state[1] != RETEST_FAIL, title="Retest Fail", style=shape.xcross, location=location.abovebar, size=size.tiny, text="F")
plotshape(showSignals and decisionState == DEC_LONG and decisionState[1] != DEC_LONG, title="Long Bias", style=shape.triangleup, location=location.belowbar, size=size.tiny, text="LB")
plotshape(showSignals and decisionState == DEC_SHORT and decisionState[1] != DEC_SHORT, title="Short Bias", style=shape.triangledown, location=location.abovebar, size=size.tiny, text="SB")
plotshape(showSignals and invalidationCandidateConfirmed and not invalidationCandidateConfirmed[1], title="Invalidation Candidate", style=shape.xcross, location=location.abovebar, size=size.tiny, text="IC")
plotshape(showSignals and recoveryConfirmed and not recoveryConfirmed[1], title="Decision Recovery", style=shape.circle, location=location.belowbar, size=size.tiny, text="REC")
plotshape(showSignals and decisionState == DEC_INVALID and decisionState[1] != DEC_INVALID, title="Decision Invalidated", style=shape.xcross, location=location.abovebar, size=size.tiny, text="I")