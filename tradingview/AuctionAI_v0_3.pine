//@version=6
indicator("AuctionAI v0.3 - Effort vs Result Engine", overlay=true)

// Sprint 1.3
// Context -> Auction -> Acceptance -> Effort vs Result

showPanel = input.bool(true, "Show AuctionAI Panel")
lookback = input.int(50, "Balance Lookback")

rangeHigh = ta.highest(high, lookback)
rangeLow = ta.lowest(low, lookback)
rangeSize = rangeHigh - rangeLow
position = rangeSize != 0 ? (close - rangeLow) / rangeSize : 0.5

location = position > 0.75 ? "UPPER VALUE" : position < 0.25 ? "LOWER VALUE" : "MID VALUE"

atr = ta.atr(14)
body = math.abs(close-open)
candleRange = high-low

volumeStrength = volume > ta.sma(volume,20) ? "HIGH" : "LOW"
resultStrength = candleRange > atr ? "HIGH" : "LOW"

string effortResult = "NORMAL"
string interpretation = "Balanced Activity"

if volume > ta.sma(volume,20) and candleRange < atr * 0.7
    effortResult := "HIGH EFFORT LOW RESULT"
    interpretation := "Possible Absorption"
else if volume > ta.sma(volume,20) and candleRange > atr
    effortResult := "HIGH EFFORT HIGH RESULT"
    interpretation := "Initiative Activity"

string participant = "NEUTRAL"
if close > open and effortResult == "HIGH EFFORT LOW RESULT"
    participant := "Responsive Seller Possible"
else if close < open and effortResult == "HIGH EFFORT LOW RESULT"
    participant := "Responsive Buyer Possible"

contextScore = 0
if location == "UPPER VALUE"
    contextScore := 1
else if location == "LOWER VALUE"
    contextScore := -1

confidence = 5 + contextScore + (effortResult == "HIGH EFFORT HIGH RESULT" ? 1 : 0)

var table panel = table.new(position.top_right,2,10,border_width=1)

if barstate.islast and showPanel
    table.cell(panel,0,0,"AuctionAI v0.3")
    table.cell(panel,1,0,"ACTIVE")
    table.cell(panel,0,1,"Location")
    table.cell(panel,1,1,location)
    table.cell(panel,0,2,"Volume Effort")
    table.cell(panel,1,2,volumeStrength)
    table.cell(panel,0,3,"Result")
    table.cell(panel,1,3,resultStrength)
    table.cell(panel,0,4,"Effort/Result")
    table.cell(panel,1,4,effortResult)
    table.cell(panel,0,5,"Reading")
    table.cell(panel,1,5,interpretation)
    table.cell(panel,0,6,"Participant")
    table.cell(panel,1,6,participant)
    table.cell(panel,0,7,"Delta")
    table.cell(panel,1,7,"Pending")
    table.cell(panel,0,8,"CVD")
    table.cell(panel,1,8,"Pending")
    table.cell(panel,0,9,"Confidence")
    table.cell(panel,1,9,str.tostring(confidence)+"/10")

plot(rangeHigh,"Balance High",color=color.gray)
plot(rangeLow,"Balance Low",color=color.gray)
