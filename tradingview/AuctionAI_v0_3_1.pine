//@version=6
indicator("AuctionAI v0.3.1 - Context + Effort Engine", overlay=true)

// Sprint 1.3.1
// Restore Sprint 1.2 auction layer
// Add Effort vs Result layer

showPanel = input.bool(true, "Show AuctionAI Panel")
lookback = input.int(50, "Balance Lookback")

rangeHigh = ta.highest(high, lookback)
rangeLow = ta.lowest(low, lookback)
rangeSize = rangeHigh - rangeLow
pos = rangeSize != 0 ? (close-rangeLow)/rangeSize : 0.5

location = pos > 0.75 ? "UPPER VALUE" : pos < 0.25 ? "LOWER VALUE" : "MID VALUE"

breakoutUp = close > rangeHigh
breakoutDown = close < rangeLow

attempt = breakoutUp ? "BREAKOUT UP" : breakoutDown ? "BREAKOUT DOWN" : "NONE"

atr = ta.atr(14)
body = math.abs(close-open)

acceptUp = breakoutUp and body > atr*0.7
acceptDown = breakoutDown and body > atr*0.7

rejectUp = high > rangeHigh and close < rangeHigh
rejectDown = low < rangeLow and close > rangeLow

auction = "BALANCE AUCTION"
decision = "WAITING"
hypothesis = "Searching For Value"

if acceptUp
    auction := "NEW VALUE HIGHER"
    decision := "ACCEPTED"
    hypothesis := "Initiative Buyers Active"
else if acceptDown
    auction := "NEW VALUE LOWER"
    decision := "ACCEPTED"
    hypothesis := "Initiative Sellers Active"
else if rejectUp
    auction := "FAILED AUCTION"
    decision := "REJECTION"
    hypothesis := "Responsive Seller Possible"
else if rejectDown
    auction := "FAILED AUCTION"
    decision := "REJECTION"
    hypothesis := "Responsive Buyer Possible"

volumeHigh = volume > ta.sma(volume,20)
resultHigh = (high-low) > atr

effortResult = "NORMAL"
reading = "Balanced Activity"

if volumeHigh and not resultHigh
    effortResult := "HIGH EFFORT LOW RESULT"
    reading := "Possible Absorption"
else if volumeHigh and resultHigh
    effortResult := "HIGH EFFORT HIGH RESULT"
    reading := "Initiative Activity"

participant = effortResult == "HIGH EFFORT LOW RESULT" and close > open ? "Responsive Seller Possible" : effortResult == "HIGH EFFORT LOW RESULT" and close < open ? "Responsive Buyer Possible" : "Neutral"

contextScore = location == "UPPER VALUE" ? 1 : location == "LOWER VALUE" ? -1 : 0

confidence = 5 + contextScore + (decision == "ACCEPTED" ? 1 : 0)

var table panel = table.new(position.top_right,2,14,border_width=1)

if barstate.islast and showPanel
    table.cell(panel,0,0,"AuctionAI v0.3.1")
    table.cell(panel,1,0,"ACTIVE")
    table.cell(panel,0,1,"Location")
    table.cell(panel,1,1,location)
    table.cell(panel,0,2,"Attempt")
    table.cell(panel,1,2,attempt)
    table.cell(panel,0,3,"Auction")
    table.cell(panel,1,3,auction)
    table.cell(panel,0,4,"Decision")
    table.cell(panel,1,4,decision)
    table.cell(panel,0,5,"Hypothesis")
    table.cell(panel,1,5,hypothesis)
    table.cell(panel,0,6,"Context Score")
    table.cell(panel,1,6,str.tostring(contextScore))
    table.cell(panel,0,7,"Effort/Result")
    table.cell(panel,1,7,effortResult)
    table.cell(panel,0,8,"Reading")
    table.cell(panel,1,8,reading)
    table.cell(panel,0,9,"Participant")
    table.cell(panel,1,9,participant)
    table.cell(panel,0,10,"Delta")
    table.cell(panel,1,10,"Pending")
    table.cell(panel,0,11,"CVD")
    table.cell(panel,1,11,"Pending")
    table.cell(panel,0,12,"Confidence")
    table.cell(panel,1,12,str.tostring(confidence)+"/10")

plot(rangeHigh,"Balance High",color=color.gray)
plot(rangeLow,"Balance Low",color=color.gray)
