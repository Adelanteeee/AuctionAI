//@version=6
indicator("AuctionAI v2.1 - Candidate Competition + Learning Memory", overlay=true, max_bars_back=5000)

validationHorizon = input.int(5,"Validation Horizon",minval=1)
favorableAtr = input.float(0.50,"Favorable Threshold (ATR)",minval=0,step=0.05)
archiveLimit = input.int(500,"Archive Size",minval=100,maxval=1000)
researchMin = input.int(50,"Research Minimum",minval=20,maxval=500)
shadowMin = input.int(100,"Minimum Shadow Outcomes",minval=50,maxval=500)
shadowMaxInput = input.int(200,"Maximum Shadow Outcomes",minval=100,maxval=500)
shadowMax = math.max(shadowMin,shadowMaxInput)
holdoutPct = input.int(10,"Final Holdout %",minval=5,maxval=20)
holdoutMin = input.int(20,"Minimum Holdout Samples",minval=10,maxval=100)
gateMin = input.int(20,"Gate Minimum Samples",minval=10,maxval=100)
minLift = input.float(2.0,"Minimum Improvement (pp)",minval=0,step=0.5)
maxRegression = input.float(3.0,"Maximum Regression (pp)",minval=0,step=0.5)
maxCandidates = input.int(20,"Candidate Registry Capacity",minval=5,maxval=50)
maxWeightDelta = input.int(1,"Maximum Weight Change",minval=1,maxval=1)
monitorWindow = input.int(150,"Champion Monitoring Window",minval=30,maxval=300)
monitorRegression = input.float(8.0,"Champion Regression (pp)",minval=1,step=0.5)
learningFailureLimit = input.int(3,"Learning Failure Limit",minval=1,maxval=10)

wDelta = input.int(2,"Baseline Delta Weight",minval=-10,maxval=10)
wCvd = input.int(2,"Baseline CVD Weight",minval=-10,maxval=10)
wEffort = input.int(1,"Baseline Effort Weight",minval=-10,maxval=10)
wResult = input.int(1,"Baseline Result Weight",minval=-10,maxval=10)
wBody = input.int(1,"Baseline Strong Body Weight",minval=-10,maxval=10)
wBreakout = input.int(2,"Baseline Breakout Weight",minval=-10,maxval=10)
wAbsorption = input.int(-3,"Baseline Absorption Weight",minval=-10,maxval=10)
humanApproval = input.bool(false,"HUMAN APPROVAL: Apply Winner")
manualRollback = input.bool(false,"MANUAL ROLLBACK")

atr = math.max(nz(ta.atr(14),syminfo.mintick),syminfo.mintick)
body = close-open
rng = high-low
vAvg = math.max(nz(ta.sma(volume,20),volume),1)
delta = body/atr
cvd = ta.ema(delta,5)
effort = volume/vAvg
result = math.abs(body)/atr
xDelta = body!=0
xCvd = (body>0 and cvd>0) or (body<0 and cvd<0)
xEffort = effort>=1
xResult = body!=0 and result>=0.5
xBody = rng>atr*0.75
xBreakout = close>nz(high[20],high) or close<nz(low[20],low)
xAbs = effort>1.5 and result<0.35
ctx = math.abs(close-nz(close[10],close))/atr>1.5 ? "TREND" : "RANGE"

rate(_w,_n)=>_n>0?_w*100.0/_n:na
score(_a,_c,_e,_r,_b,_br,_ab)=>
    s=0
    s+=xDelta?_a:0
    s+=xCvd?_c:0
    s+=xEffort?_e:0
    s+=xResult?_r:0
    s+=xBody?_b:0
    s+=xBreakout?_br:0
    s+=xAbs?_ab:0
    s
dir(_s)=>_s>=3?1:_s<=-3?-1:0
retest(_m,_d)=>
    z=_d==0?0.0:_m*_d
    z>=favorableAtr?"HOLD":z>=0?"RECLAIM":z>-0.25?"WEAK":z>-0.50?"BREACH":"FAIL"

var int activeDelta=wDelta
var int activeCvd=wCvd
var int activeEffort=wEffort
var int activeResult=wResult
var int activeBody=wBody
var int activeBreakout=wBreakout
var int activeAbsorption=wAbsorption

var array<int> aDir=array.new_int()
var array<string> aCtx=array.new_string()
var array<string> aOut=array.new_string()
var array<string> aRetest=array.new_string()
var array<bool> aDelta=array.new_bool()
var array<bool> aCvd=array.new_bool()
var array<bool> aEffort=array.new_bool()
var array<bool> aResult=array.new_bool()
var array<bool> aBody=array.new_bool()
var array<bool> aBreak=array.new_bool()
var array<bool> aAbs=array.new_bool()
var bool baseActive=false
var int baseDir=0
var int baseBar=na
var float baseEntry=na
var float baseAtr=na
bs=score(activeDelta,activeCvd,activeEffort,activeResult,activeBody,activeBreakout,activeAbsorption)
bd=dir(bs)
if not baseActive and bd!=0
    baseActive:=true
    baseDir:=bd
    baseBar:=bar_index
    baseEntry:=close
    baseAtr:=atr
if baseActive and bar_index-baseBar>=validationHorizon
    mv=(close-baseEntry)/baseAtr*baseDir
    ok=mv>=favorableAtr
    array.push(aDir,baseDir),array.push(aCtx,ctx),array.push(aOut,ok?"VALIDATED":"FAILED"),array.push(aRetest,retest(mv,baseDir))
    array.push(aDelta,xDelta),array.push(aCvd,xCvd),array.push(aEffort,xEffort),array.push(aResult,xResult),array.push(aBody,xBody),array.push(aBreak,xBreakout),array.push(aAbs,xAbs)
    while array.size(aDir)>archiveLimit
        array.shift(aDir),array.shift(aCtx),array.shift(aOut),array.shift(aRetest),array.shift(aDelta),array.shift(aCvd),array.shift(aEffort),array.shift(aResult),array.shift(aBody),array.shift(aBreak),array.shift(aAbs)
    baseActive:=false

N=array.size(aDir)
researchN=int(math.floor(N*0.70))
researchW=0
if researchN>0
    for i=0 to researchN-1
        researchW+=array.get(aOut,i)=="VALIDATED"?1:0
researchRate=rate(researchW,researchN)

var array<int> cId=array.new_int()
var array<string> cE=array.new_string()
var array<int> cFrom=array.new_int()
var array<int> cTo=array.new_int()
var array<float> cPriority=array.new_float()
var array<float> cLift=array.new_float()
var array<int> cSample=array.new_int()
var array<string> cStatus=array.new_string()
var array<int> cShadowN=array.new_int()
var array<float> cShadowRate=array.new_float()
var array<float> cHoldoutRate=array.new_float()
var array<float> cCompetition=array.new_float()
var array<string> cReason=array.new_string()
var array<int> cFailures=array.new_int()
var array<float> cTrend=array.new_float()
var array<float> cRange=array.new_float()
var array<float> cHold=array.new_float()
var array<float> cWeak=array.new_float()
var array<float> cBreach=array.new_float()
var array<float> cReclaim=array.new_float()
var array<float> cFail=array.new_float()
var array<float> cInteraction=array.new_float()
var int nextId=1
var int lastResearchN=na
var int lastResearchW=na

getW(_e)=>_e=="CVD"?activeCvd:_e=="Delta"?activeDelta:_e=="Effort"?activeEffort:_e=="Result"?activeResult:_e=="Strong Body"?activeBody:_e=="Breakout"?activeBreakout:activeAbsorption
hit(_e,_i)=>_e=="CVD"?array.get(aCvd,_i):_e=="Delta"?array.get(aDelta,_i):_e=="Effort"?array.get(aEffort,_i):_e=="Result"?array.get(aResult,_i):_e=="Strong Body"?array.get(aBody,_i):_e=="Breakout"?array.get(aBreak,_i):array.get(aAbs,_i)
exists(_e,_f,_t)=>
    z=false
    if array.size(cId)>0
        for i=0 to array.size(cId)-1
            z:=z or (array.get(cE,i)==_e and array.get(cFrom,i)==_f and array.get(cTo,i)==_t)
    z

researchChanged=na(lastResearchN) or researchN!=lastResearchN or researchW!=lastResearchW
if N>=researchMin and researchN>=researchMin and researchChanged
    lastResearchN:=researchN
    lastResearchW:=researchW
    es=array.from("CVD","Delta","Effort","Result","Strong Body","Breakout","Absorption")
    for ei=0 to array.size(es)-1
        e=array.get(es,ei)
        en=0
        ew=0
        for i=0 to researchN-1
            if hit(e,i)
                en+=1
                ew+=array.get(aOut,i)=="VALIDATED"?1:0
        er=rate(ew,en)
        lift=not na(er) and not na(researchRate)?er-researchRate:na
        f=getW(e)
        d=not na(lift) and en>=gateMin?(lift>=minLift?1:lift<=-minLift?-1:0):0
        t=f+d
        if d!=0 and array.size(cId)<maxCandidates and not exists(e,f,t)
            fails=0
            if array.size(cId)>0
                for j=0 to array.size(cId)-1
                    fails+=array.get(cE,j)==e and array.get(cFrom,j)==f and array.get(cTo,j)==t and array.get(cStatus,j)=="REJECTED"?1:0
            priority=math.max(0,math.min(100,math.abs(lift)*3+math.min(40,en*40.0/researchN)+20-fails*20))
            array.push(cId,nextId),array.push(cE,e),array.push(cFrom,f),array.push(cTo,t),array.push(cPriority,priority),array.push(cLift,lift),array.push(cSample,en),array.push(cStatus,"QUEUED")
            array.push(cShadowN,0),array.push(cShadowRate,na),array.push(cHoldoutRate,na),array.push(cCompetition,na),array.push(cReason,"Fresh recommendation"),array.push(cFailures,fails)
            array.push(cTrend,na),array.push(cRange,na),array.push(cHold,na),array.push(cWeak,na),array.push(cBreach,na),array.push(cReclaim,na),array.push(cFail,na),array.push(cInteraction,na)
            nextId+=1

var int active=-1
var int sN=0
var int sW=0
var int hN=0
var int hW=0
var int sLongN=0
var int sLongW=0
var int sShortN=0
var int sShortW=0
var int bLongN=0
var int bLongW=0
var int bShortN=0
var int bShortW=0
var int tN=0
var int tW=0
var int rN=0
var int rW=0
var int holdN=0
var int holdW=0
var int weakN=0
var int weakW=0
var int breachN=0
var int breachW=0
var int reclaimN=0
var int reclaimW=0
var int failN=0
var int failW=0
var int intN=0
var int intW=0
var bool shadowActive=false
var int shDir=0
var int shBaseDir=0
var int shBar=na
var float shEntry=na
var float shAtr=na
var string shCtx="RANGE"

pickCandidate()=>
    p=-1
    best=-1.0
    if array.size(cId)>0
        for i=0 to array.size(cId)-1
            if array.get(cStatus,i)=="QUEUED" and array.get(cPriority,i)>best
                best:=array.get(cPriority,i),p:=i
    p

if active<0
    p=pickCandidate()
    if p>=0
        active:=p
        array.set(cStatus,active,"SHADOW")
        sN:=0,sW:=0,hN:=0,hW:=0,sLongN:=0,sLongW:=0,sShortN:=0,sShortW:=0,bLongN:=0,bLongW:=0,bShortN:=0,bShortW:=0
        tN:=0,tW:=0,rN:=0,rW:=0,holdN:=0,holdW:=0,weakN:=0,weakW:=0,breachN:=0,breachW:=0,reclaimN:=0,reclaimW:=0,failN:=0,failW:=0,intN:=0,intW:=0
        shadowActive:=false

ce=active>=0?array.get(cE,active):""
cf=active>=0?array.get(cFrom,active):0
ct=active>=0?array.get(cTo,active):0
candScore(_e)=>
    score(_e=="Delta"?ct:activeDelta,_e=="CVD"?ct:activeCvd,_e=="Effort"?ct:activeEffort,_e=="Result"?ct:activeResult,_e=="Strong Body"?ct:activeBody,_e=="Breakout"?ct:activeBreakout,_e=="Absorption"?ct:activeAbsorption)

if active>=0 and not shadowActive and sN<shadowMax
    b=score(activeDelta,activeCvd,activeEffort,activeResult,activeBody,activeBreakout,activeAbsorption)
    s=candScore(ce)
    shBaseDir:=dir(b),shDir:=dir(s)
    if shBaseDir!=0 or shDir!=0
        shadowActive:=true,shBar:=bar_index,shEntry:=close,shAtr:=atr,shCtx:=ctx
if active>=0 and shadowActive and bar_index-shBar>=validationHorizon
    raw=(close-shEntry)/shAtr
    sw=shDir!=0 and raw*shDir>=favorableAtr
    bw=shBaseDir!=0 and raw*shBaseDir>=favorableAtr
    holdoutStart=int(math.floor(shadowMax*(100-holdoutPct)/100.0))
    isHoldout=sN>=holdoutStart
    rs=retest(raw,shDir)
    if isHoldout
        hN+=1,hW+=sw?1:0
    else
        sN+=1,sW+=sw?1:0
        if shDir>0
            sLongN+=1,sLongW+=sw?1:0
        else if shDir<0
            sShortN+=1,sShortW+=sw?1:0
        if shBaseDir>0
            bLongN+=1,bLongW+=bw?1:0
        else if shBaseDir<0
            bShortN+=1,bShortW+=bw?1:0
        if shCtx=="TREND"
            tN+=1,tW+=sw?1:0
        else
            rN+=1,rW+=sw?1:0
        if rs=="HOLD"
            holdN+=1,holdW+=sw?1:0
        else if rs=="RECLAIM"
            reclaimN+=1,reclaimW+=sw?1:0
        else if rs=="WEAK"
            weakN+=1,weakW+=sw?1:0
        else if rs=="BREACH"
            breachN+=1,breachW+=sw?1:0
        else
            failN+=1,failW+=sw?1:0
        aligned=ce=="CVD"?xDelta:ce=="Delta"?xCvd:false
        if aligned
            intN+=1,intW+=sw?1:0
    shadowActive:=false

holdoutStart=int(math.floor(shadowMax*(100-holdoutPct)/100.0))
effectiveHoldoutMin=math.max(1,math.min(holdoutMin,shadowMax-holdoutStart))
evalRate=rate(sW,sN)
baseN=bLongN+bShortN
baseW=bLongW+bShortW
baseRate=rate(baseW,baseN)
holdRate=rate(hW,hN)
improvement=not na(evalRate) and not na(baseRate)?evalRate-baseRate:na
directionReady=sLongN>=gateMin and sShortN>=gateMin and bLongN>=gateMin and bShortN>=gateMin
longReg=directionReady and rate(sLongW,sLongN)-rate(bLongW,bLongN)<-maxRegression
shortReg=directionReady and rate(sShortW,sShortN)-rate(bShortW,bShortN)<-maxRegression
directionPass=directionReady and not longReg and not shortReg
candidateReady=active>=0 and sN+hN>=shadowMax
if candidateReady
    holdPass=hN>=effectiveHoldoutMin and not na(holdRate) and not na(baseRate) and holdRate-baseRate>=minLift
    evalPass=sN>=math.max(1,shadowMin-effectiveHoldoutMin) and not na(improvement) and improvement>=minLift
    pass=evalPass and holdPass and directionPass
    trendRate=rate(tW,tN),rangeRate=rate(rW,rN),holdRate2=rate(holdW,holdN),weakRate=rate(weakW,weakN),breachRate=rate(breachW,breachN),reclaimRate=rate(reclaimW,reclaimN),failRate=rate(failW,failN)
    comp=nz(improvement,-100)*2+nz(holdRate-baseRate, -100)+math.min(15,nz(trendRate,0)+nz(rangeRate,0))/2+math.min(15,nz(holdRate2,0)+nz(reclaimRate,0))/2+math.max(-10,math.min(10,nz(rate(intW,intN)-baseRate,0)))+(directionPass?20:-30)
    array.set(cShadowN,active,sN+hN),array.set(cShadowRate,active,evalRate),array.set(cHoldoutRate,active,holdRate),array.set(cCompetition,active,comp)
    array.set(cTrend,active,trendRate),array.set(cRange,active,rangeRate),array.set(cHold,active,holdRate2),array.set(cWeak,active,weakRate),array.set(cBreach,active,breachRate),array.set(cReclaim,active,reclaimRate),array.set(cFail,active,failRate),array.set(cInteraction,active,rate(intW,intN)-baseRate)
    array.set(cStatus,active,pass?"APPROVAL READY":"REJECTED")
    array.set(cReason,active,pass?"Gates passed; competition eligible":not evalPass?"Evaluation regression":not holdPass?"Holdout failed":"Direction regression/sample gate")
    active:=-1

var int winner=-1
winner:=-1
if array.size(cId)>0
    best=-100000.0
    for i=0 to array.size(cId)-1
        if array.get(cStatus,i)=="APPROVAL READY" and array.get(cCompetition,i)>best
            best:=array.get(cCompetition,i),winner:=i

var int champion=0
var int previousChampion=0
var int applied=0
var int rollbacks=0
var int failures=0
var bool learningPaused=false
var bool monitoring=false
var int monitorN=0
var int monitorNewW=0
var int monitorOldW=0
var string monitorE=""
var int monitorOldWeight=na

if winner>=0 and humanApproval
    previousChampion:=champion
    e=array.get(cE,winner),to=array.get(cTo,winner)
    if e=="CVD"
        activeCvd:=to
    else if e=="Delta"
        activeDelta:=to
    else if e=="Effort"
        activeEffort:=to
    else if e=="Result"
        activeResult:=to
    else if e=="Strong Body"
        activeBody:=to
    else if e=="Breakout"
        activeBreakout:=to
    else
        activeAbsorption:=to
    champion:=array.get(cId,winner),array.set(cStatus,winner,"MONITORING")
    applied+=1,monitoring:=true,monitorN:=0,monitorNewW:=0,monitorOldW:=0,monitorE:=e,monitorOldWeight:=array.get(cFrom,winner)

if monitoring and not baseActive
    // Monitoring is evaluated on completed production decisions. The previous Champion is reconstructed with its frozen weight.
    if bar_index>0
        oldScore=score(monitorE=="Delta"?monitorOldWeight:activeDelta,monitorE=="CVD"?monitorOldWeight:activeCvd,monitorE=="Effort"?monitorOldWeight:activeEffort,monitorE=="Result"?monitorOldWeight:activeResult,monitorE=="Strong Body"?monitorOldWeight:activeBody,monitorE=="Breakout"?monitorOldWeight:activeBreakout,monitorE=="Absorption"?monitorOldWeight:activeAbsorption)
        newScore=score(activeDelta,activeCvd,activeEffort,activeResult,activeBody,activeBreakout,activeAbsorption)
        od=dir(oldScore),nd=dir(newScore)
        if od!=0 or nd!=0
            mv=(close-nz(close[validationHorizon],close))/atr
            monitorOldW+=od!=0 and mv*od>=favorableAtr?1:0
            monitorNewW+=nd!=0 and mv*nd>=favorableAtr?1:0
            monitorN+=1
            if monitorN>=monitorWindow
                if rate(monitorNewW,monitorN)-rate(monitorOldW,monitorN)<-monitorRegression
                    failures+=1
                else
                    failures:=math.max(0,failures-1)
                monitoring:=false
                if failures>=learningFailureLimit
                    learningPaused:=true

if manualRollback and champion!=0
    ridx=-1
    for i=0 to array.size(cId)-1
        if array.get(cId,i)==champion
            ridx:=i
    if ridx>=0
        e=array.get(cE,ridx),old=array.get(cFrom,ridx)
        if e=="CVD"
            activeCvd:=old
        else if e=="Delta"
            activeDelta:=old
        else if e=="Effort"
            activeEffort:=old
        else if e=="Result"
            activeResult:=old
        else if e=="Strong Body"
            activeBody:=old
        else if e=="Breakout"
            activeBreakout:=old
        else
            activeAbsorption:=old
        array.set(cStatus,ridx,"ROLLBACK"),rollbacks+=1,failures+=1,champion:=previousChampion
        if failures>=learningFailureLimit
            learningPaused:=true

queued=0
rejected=0
ready=0
if array.size(cId)>0
    for i=0 to array.size(cId)-1
        queued+=array.get(cStatus,i)=="QUEUED"?1:0
        rejected+=array.get(cStatus,i)=="REJECTED"?1:0
        ready+=array.get(cStatus,i)=="APPROVAL READY"?1:0

var table hud=table.new(position.top_right,3,24,border_width=1)
if barstate.islast
    table.cell(hud,0,0,"AUCTION AI v2.1"),table.cell(hud,1,0,"CANDIDATE COMPETITION + MEMORY"),table.cell(hud,2,0,learningPaused?"LEARNING PAUSED":"CONTROLLED")
    table.cell(hud,0,1,"Registry"),table.cell(hud,1,1,str.tostring(array.size(cId))+" / "+str.tostring(maxCandidates)),table.cell(hud,2,1,"Queued "+str.tostring(queued))
    table.cell(hud,0,2,"Shadow"),table.cell(hud,1,2,active<0?"-": "C-"+str.tostring(array.get(cId,active))),table.cell(hud,2,2,active<0?"-":array.get(cStatus,active))
    table.cell(hud,0,3,"Winner"),table.cell(hud,1,3,winner<0?"-":"C-"+str.tostring(array.get(cId,winner))),table.cell(hud,2,3,winner<0?"-":array.get(cE,winner)+" "+str.tostring(array.get(cFrom,winner))+" -> "+str.tostring(array.get(cTo,winner)))
    table.cell(hud,0,4,"Evaluation"),table.cell(hud,1,4,str.tostring(sN+ hN)+" / "+str.tostring(shadowMax)),table.cell(hud,2,4,"Δ "+str.tostring(improvement,"#.0")+" pp")
    table.cell(hud,0,5,"Holdout"),table.cell(hud,1,5,str.tostring(hN)+" / "+str.tostring(effectiveHoldoutMin)),table.cell(hud,2,5,hN>=effectiveHoldoutMin?(holdRate-baseRate>=minLift?"PASS":"FAIL"):"NOT ENOUGH DATA")
    table.cell(hud,0,6,"Direction"),table.cell(hud,1,6,"L "+str.tostring(rate(sLongW,sLongN),"#.0")+" / S "+str.tostring(rate(sShortW,sShortN),"#.0")),table.cell(hud,2,6,directionReady?(directionPass?"PASS":"REGRESSION"):"NOT ENOUGH DATA")
    table.cell(hud,0,7,"Competition"),table.cell(hud,1,7,winner<0?"-":str.tostring(array.get(cCompetition,winner),"#.0")),table.cell(hud,2,7,"Winner != Apply")
    table.cell(hud,0,8,"Champion"),table.cell(hud,1,8,champion==0?"BASELINE":"C-"+str.tostring(champion)),table.cell(hud,2,8,"Human approval")
    table.cell(hud,0,9,"Monitoring"),table.cell(hud,1,9,monitoring?str.tostring(monitorN)+" / "+str.tostring(monitorWindow):"-"),table.cell(hud,2,9,"Previous vs Active")
    table.cell(hud,0,10,"Memory"),table.cell(hud,1,10,str.tostring(array.size(cId))+" candidates"),table.cell(hud,2,10,"Failures "+str.tostring(failures))
    table.cell(hud,0,11,"Rejected"),table.cell(hud,1,11,str.tostring(rejected)),table.cell(hud,2,11,"Reason retained")
    table.cell(hud,0,12,"Approval Ready"),table.cell(hud,1,12,str.tostring(ready)),table.cell(hud,2,12,"Holdout gated")
    table.cell(hud,0,13,"Research"),table.cell(hud,1,13,str.tostring(researchN)),table.cell(hud,2,13,"Recommendation driven")
    table.cell(hud,0,14,"Context"),table.cell(hud,1,14,"TREND / RANGE"),table.cell(hud,2,14,"Candidate memory")
    table.cell(hud,0,15,"Retest"),table.cell(hud,1,15,"HOLD/RECLAIM/WEAK/BREACH/FAIL"),table.cell(hud,2,15,"Candidate memory")
    table.cell(hud,0,16,"Interaction"),table.cell(hud,1,16,"Evidence alignment"),table.cell(hud,2,16,"Research memory")
    table.cell(hud,0,17,"Family"),table.cell(hud,1,17,"Weight transitions"),table.cell(hud,2,17,"Repeated-failure penalty")
    table.cell(hud,0,18,"Active CVD"),table.cell(hud,1,18,str.tostring(activeCvd)),table.cell(hud,2,18,"Baseline "+str.tostring(wCvd))
    table.cell(hud,0,19,"Active Delta"),table.cell(hud,1,19,str.tostring(activeDelta)),table.cell(hud,2,19,"Baseline "+str.tostring(wDelta))
    table.cell(hud,0,20,"Applied"),table.cell(hud,1,20,str.tostring(applied)),table.cell(hud,2,20,"Champion history")
